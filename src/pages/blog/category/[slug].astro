---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getBlogPosts, getPostsByCategorySlug, getCategories, getTags, type BlogPost } from '../../../lib/payload';

// Generate static paths for all category pages
export async function getStaticPaths() {
  const categories = await getCategories();
  
  return categories.map((cat) => ({
    params: { slug: cat.slug },
  }));
}

const POSTS_PER_PAGE = 9;
const INITIAL_LOAD = 10;
const { slug } = Astro.params;

const categoryPosts = await getPostsByCategorySlug(slug || '');
const allCategories = await getCategories();
const category = allCategories.find(c => c.slug === slug);
const allTags = await getTags();

const sortedPosts = [...categoryPosts].sort((a, b) =>
  new Date(b.date).getTime() - new Date(a.date).getTime()
);

const featuredPost = sortedPosts.length > 0 ? sortedPosts[0] : null;
const initialPosts = sortedPosts.slice(0, INITIAL_LOAD);
const remainingPosts = sortedPosts.slice(INITIAL_LOAD);

const popularPosts = sortedPosts
  .filter(post => post.seo?.focusKeyword)
  .slice(0, 5);

const topCategories = allCategories
  .sort((a, b) => b.count - a.count)
  .slice(0, 8);

const topTags = allTags
  .sort((a, b) => b.count - a.count)
  .slice(0, 12);

function formatDate(dateString: string): string {
  return new Date(dateString).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  });
}

function stripHtml(html: string): string {
  if (!html) return '';
  return html.replace(/<[^>]*>/g, '').trim();
}

function decodeHtml(html: string): string {
  if (!html) return '';
  return html
    .replace(/&#8217;/g, "'")
    .replace(/&#8216;/g, "'")
    .replace(/&#8218;/g, "'")
    .replace(/&#8220;/g, '"')
    .replace(/&#8221;/g, '"')
    .replace(/&#8230;/g, '...')
    .replace(/&#8211;/g, '-')
    .replace(/&#8212;/g, '--')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#x27;/g, "'")
    .replace(/&#x2F;/g, '/')
    .replace(/&#39;/g, "'")
    .replace(/&apos;/g, "'");
}

function getReadingTime(content: string): string {
  const text = stripHtml(content);
  const words = text.split(/\s+/).length;
  return `${Math.ceil(words / 200)} min read`;
}

function getExcerpt(content: string, htmlExcerpt: string, title: string, length: number = 160): string {
  if (htmlExcerpt) {
    let text = stripHtml(htmlExcerpt);
    if (title && text.toLowerCase().startsWith(title.toLowerCase())) {
      text = text.substring(title.length).trim();
    }
    if (text.length <= length) return text;
    return text.substring(0, length).trim() + '...';
  }
  const text = stripHtml(content);
  if (text.length <= length) return text;
  return text.substring(0, length).trim() + '...';
}

function getFeaturedImage(post: BlogPost): string {
  return post.featuredImage || '';
}

function getCategoryNames(post: BlogPost): string[] {
  return post.categories || [];
}

const postsData = sortedPosts.map(post => ({
  slug: post.slug,
  title: post.title,
  content: post.content,
  excerpt: post.excerpt,
  date: post.date,
  featuredImage: getFeaturedImage(post),
  categories: getCategoryNames(post),
  readingTime: getReadingTime(post.content)
}));

const pageTitle = category 
  ? `${category.name} - LiteScaler Blog`
  : `Category: ${slug} - LiteScaler Blog`;
---

<BaseLayout title={pageTitle}>
  {featuredPost && (
    <section class="hero-section">
      <div class="hero-bg">
        {getFeaturedImage(featuredPost) && (
          <img src={getFeaturedImage(featuredPost)} alt="" class="hero-image" loading="eager" />
        )}
        <div class="hero-gradient"></div>
      </div>
      
      <div class="hero-container">
        <div class="hero-content">
          <div class="hero-header">
            <span class="hero-badge">
              <span class="badge-dot"></span>
              {category?.name || 'Category'}
            </span>
            <span class="hero-date">{formatDate(featuredPost.date)}</span>
          </div>
          
          <h1 class="hero-title">
            <a href={`/blog/${featuredPost.slug}`}><span set:html={decodeHtml(featuredPost.title)} /></a>
          </h1>
          
          <p class="hero-excerpt">
            {getExcerpt(featuredPost.content, featuredPost.excerpt, featuredPost.title, 200)}
          </p>
          
          <div class="hero-meta-row">
            <span class="hero-category">{getCategoryNames(featuredPost)[0] || 'Article'}</span>
            <span class="hero-readtime">{getReadingTime(featuredPost.content)}</span>
          </div>
          
          <a href={`/blog/${featuredPost.slug}`} class="hero-cta">
            Read Article
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
        
        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-value">{sortedPosts.length}</span>
            <span class="stat-label">{sortedPosts.length === 1 ? 'Article' : 'Articles'}</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-value">{topCategories.length}</span>
            <span class="stat-label">Categories</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-value">{topTags.length}+</span>
            <span class="stat-label">Topics</span>
          </div>
        </div>
      </div>
    </section>
  )}

  {sortedPosts.length === 0 && (
    <section class="no-posts-section">
      <div class="no-posts-content">
        <div class="no-posts-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
          </svg>
        </div>
        <h1>No articles found in "{category?.name || slug}"</h1>
        <p>This category doesn't have any published articles yet.</p>
        <a href="/blog" class="back-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          Back to all articles
        </a>
      </div>
    </section>
  )}

  {sortedPosts.length > 0 && (
    <main class="main-content">
      <div class="content-wrapper">
        <header class="section-header">
          <div class="header-left">
            <h2 class="section-title">{category?.name || 'Latest Stories'}</h2>
            <p class="section-subtitle">{sortedPosts.length} {sortedPosts.length === 1 ? 'article' : 'articles'} in this category</p>
          </div>
          <div class="header-right">
            <div class="header-info">
              <span class="info-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2v20M2 12h20"/>
                </svg>
                Fresh content added weekly
              </span>
            </div>
          </div>
        </header>

        <div class="posts-grid" id="posts-grid">
          {initialPosts.map((post, index) => (
            <article class="post-card" style={`--card-index: ${index}`}>
              <a href={`/blog/${post.slug}`} class="card-image-link">
                <div class="card-image-wrapper">
                  {getFeaturedImage(post) ? (
                    <img src={getFeaturedImage(post)} alt={post.title} loading="lazy" class="card-image" />
                  ) : (
                    <div class="card-placeholder">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <polyline points="21 15 16 10 5 21"/>
                      </svg>
                    </div>
                  )}
                  <div class="image-overlay"></div>
                </div>
              </a>
              
              <div class="card-content">
                <div class="card-meta">
                  <span class="card-category">{getCategoryNames(post)[0] || 'Article'}</span>
                  <time datetime={post.date}>{formatDate(post.date)}</time>
                </div>
                
                <h3 class="card-title">
                  <a href={`/blog/${post.slug}`}><span set:html={decodeHtml(post.title)} /></a>
                </h3>
                
                <p class="card-excerpt">{getExcerpt(post.content, post.excerpt, post.title, 120)}</p>
                
                <div class="card-footer">
                  <span class="card-readtime">{getReadingTime(post.content)}</span>
                  <a href={`/blog/${post.slug}`} class="card-link">
                    Read more
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="pagination-area" id="pagination-area">
          {remainingPosts.length > 0 && (
            <button class="load-more-btn" id="load-more-btn" data-page="1">
              <span class="btn-text">Load More Stories</span>
              <span class="btn-loader" style="display: none;">
                <svg class="spinner" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" fill="none" stroke-dasharray="31.4 31.4"/>
                </svg>
              </span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-icon">
                <path d="M12 5v14M5 12l7 7 7-7"/>
              </svg>
            </button>
          )}
          
          {remainingPosts.length === 0 && sortedPosts.length > 1 && (
            <div class="end-message">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <span>You've caught up with all articles</span>
            </div>
          )}
        </div>
      </div>

      <aside class="sidebar">
        <div class="widget newsletter-card">
          <div class="newsletter-header">
            <div class="newsletter-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <div class="newsletter-title-group">
              <h3>Stay Updated</h3>
              <p>Get the latest posts delivered to your inbox</p>
            </div>
          </div>
          <form class="newsletter-form" onsubmit="event.preventDefault();">
            <input type="email" placeholder="Enter your email" class="newsletter-input" required />
            <button type="submit" class="newsletter-btn">
              <span>Subscribe</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </button>
          </form>
          <p class="newsletter-note">No spam, unsubscribe anytime</p>
        </div>

        <div class="widget trending-card">
          <div class="widget-header">
            <h3>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
                <polyline points="17 6 23 6 23 12"/>
              </svg>
              Trending
            </h3>
          </div>
          <ul class="trending-list">
            {popularPosts.length > 0 ? popularPosts.map((post, index) => (
              <li class="trending-item">
                <a href={`/blog/${post.slug}`} class="trending-link">
                  <span class="trending-index">{String(index + 1).padStart(2, '0')}</span>
                  <div class="trending-info">
                    <h4><span set:html={decodeHtml(post.title)} /></h4>
                    <span class="trending-meta">{getReadingTime(post.content)}</span>
                  </div>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="trending-arrow">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </a>
              </li>
            )) : (
              <>
                {[
                  { title: "Web Hosting in 2026: Complete Guide", meta: "8 min read" },
                  { title: "WordPress Optimization Best Practices", meta: "6 min read" },
                  { title: "Server Security Essentials", meta: "5 min read" },
                  { title: "VPS vs Shared Hosting: What's Best", meta: "7 min read" },
                  { title: "SSL Certificates Explained", meta: "4 min read" }
                ].map((item, i) => (
                  <li class="trending-item">
                    <a href="#" class="trending-link">
                      <span class="trending-index">{String(i + 1).padStart(2, '0')}</span>
                      <div class="trending-info">
                        <h4>{item.title}</h4>
                        <span class="trending-meta">{item.meta}</span>
                      </div>
                    </a>
                  </li>
                ))}
              </>
            )}
          </ul>
        </div>

        <div class="widget categories-card">
          <div class="widget-header">
            <h3>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7"/>
                <rect x="14" y="3" width="7" height="7"/>
                <rect x="14" y="14" width="7" height="7"/>
                <rect x="3" y="14" width="7" height="7"/>
              </svg>
              Categories
            </h3>
          </div>
          <ul class="categories-list">
            {topCategories.map((cat) => (
              <li>
                <a href={`/blog/category/${cat.slug}`} class={`category-link ${cat.slug === slug ? 'active' : ''}`}>
                  <span class="category-name">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                    </svg>
                    {cat.name}
                  </span>
                  <span class="category-arrow">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="widget tags-card">
          <div class="widget-header">
            <h3>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                <line x1="7" y1="7" x2="7.01" y2="7"/>
              </svg>
              Popular Tags
            </h3>
          </div>
          <div class="tags-cloud">
            {topTags.map((tag) => (
              <a href={`/blog/tag/${tag.slug}`} class="tag-link">{tag.name}</a>
            ))}
          </div>
        </div>

        <div class="widget cta-card">
          <div class="cta-bg-pattern"></div>
          <div class="cta-content">
            <span class="cta-badge">Special Offer</span>
            <h3>Get 82% OFF Hosting</h3>
            <p>Lightning-fast NVMe hosting with global CDN</p>
            <a href="/hosting" class="cta-btn">
              View Plans
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      </aside>
    </main>
  )}
</BaseLayout>

<script define:vars={{ postsData, POSTS_PER_PAGE }}>
  const POSTS_PER_PAGE = parseInt(POSTS_PER_PAGE);

  function decodeHtmlEntity(html) {
    if (!html) return '';
    return html
      .replace(/&#8217;/g, "'")
      .replace(/&#8216;/g, "'")
      .replace(/&#8218;/g, "'")
      .replace(/&#8220;/g, '"')
      .replace(/&#8221;/g, '"')
      .replace(/&#8230;/g, '...')
      .replace(/&#8211;/g, '-')
      .replace(/&#8212;/g, '--')
      .replace(/&amp;/g, '&')
      .replace(/&lt;/g, '<')
      .replace(/&gt;/g, '>')
      .replace(/&quot;/g, '"')
      .replace(/&#x27;/g, "'")
      .replace(/&#x2F;/g, '/')
      .replace(/&#39;/g, "'")
      .replace(/&apos;/g, "'");
  }

  document.addEventListener('DOMContentLoaded', () => {
    const loadMoreBtn = document.getElementById('load-more-btn');
    const postsGrid = document.getElementById('posts-grid');
    const paginationArea = document.getElementById('pagination-area');
    
    let currentPage = 0;
    let isLoading = false;
    let allPostsLoaded = false;
    
    function showSkeleton() {
      const skeletonGrid = document.getElementById('skeleton-grid');
      if (skeletonGrid) skeletonGrid.style.display = 'grid';
      if (loadMoreBtn) {
        loadMoreBtn.querySelector('.btn-text').textContent = 'Loading...';
        const loader = loadMoreBtn.querySelector('.btn-loader');
        if (loader) loader.style.display = 'inline-block';
        const icon = loadMoreBtn.querySelector('.btn-icon');
        if (icon) icon.style.display = 'none';
      }
    }
    
    function hideSkeleton() {
      const skeletonGrid = document.getElementById('skeleton-grid');
      if (skeletonGrid) skeletonGrid.style.display = 'none';
      if (loadMoreBtn) {
        loadMoreBtn.querySelector('.btn-text').textContent = 'Load More Stories';
        const loader = loadMoreBtn.querySelector('.btn-loader');
        if (loader) loader.style.display = 'none';
        const icon = loadMoreBtn.querySelector('.btn-icon');
        if (icon) icon.style.display = 'inline-block';
      }
    }
    
    function createPostCard(post, index) {
      const card = document.createElement('article');
      card.className = 'post-card';
      card.style.setProperty('--card-index', index);
      card.style.animationDelay = `${(index % 3) * 0.1}s`;
      
      card.innerHTML = `
        <a href="/blog/${post.slug}" class="card-image-link">
          <div class="card-image-wrapper">
            ${post.featuredImage 
              ? `<img src="${post.featuredImage}" alt="${post.title}" loading="lazy" class="card-image" />`
              : `<div class="card-placeholder"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>`
            }
            <div class="image-overlay"></div>
          </div>
        </a>
        <div class="card-content">
          <div class="card-meta">
            <span class="card-category">${post.categories[0] || 'Article'}</span>
            <time datetime="${post.date}">${new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
          </div>
          <h3 class="card-title"><a href="/blog/${post.slug}">${decodeHtmlEntity(post.title)}</a></h3>
          <p class="card-excerpt">${post.excerpt}</p>
          <div class="card-footer">
            <span class="card-readtime">${post.readingTime}</span>
            <a href="/blog/${post.slug}" class="card-link">Read more <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
          </div>
        </div>
      `;
      return card;
    }
    
    async function loadMorePosts() {
      if (isLoading || allPostsLoaded) return;
      isLoading = true;
      showSkeleton();
      await new Promise(resolve => setTimeout(resolve, 600));
      
      const start = (currentPage + 1) * POSTS_PER_PAGE;
      const end = start + POSTS_PER_PAGE;
      const newPosts = postsData.slice(start, end);
      
      if (newPosts.length === 0) {
        allPostsLoaded = true;
        hideSkeleton();
        if (loadMoreBtn) loadMoreBtn.style.display = 'none';
        const endMessage = document.createElement('div');
        endMessage.className = 'end-message';
        endMessage.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg><span>You've caught up with all ${postsData.length} articles</span>`;
        if (paginationArea) paginationArea.insertBefore(endMessage, loadMoreBtn);
        isLoading = false;
        return;
      }
      
      newPosts.forEach((post, index) => {
        const card = createPostCard(post, currentPage * POSTS_PER_PAGE + index + POSTS_PER_PAGE);
        card.style.opacity = '0';
        card.style.transform = 'translateY(20px)';
        if (postsGrid) postsGrid.appendChild(card);
        requestAnimationFrame(() => {
          card.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
          card.style.opacity = '1';
          card.style.transform = 'translateY(0)';
        });
      });
      
      currentPage++;
      hideSkeleton();
      isLoading = false;
    }
    
    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', loadMorePosts);
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting && !isLoading && !allPostsLoaded) loadMorePosts();
        });
      }, { threshold: 0.1 });
      observer.observe(loadMoreBtn);
    }
  });
</script>

{remainingPosts.length > 0 && (
  <div class="skeleton-grid" id="skeleton-grid" style="display: none;">
    {[1, 2, 3, 4, 5, 6].map((i) => (
      <article class="skeleton-card">
        <div class="skeleton-image"></div>
        <div class="skeleton-content">
          <div class="skeleton-meta"></div>
          <div class="skeleton-title"></div>
          <div class="skeleton-excerpt"></div>
          <div class="skeleton-footer"></div>
        </div>
      </article>
    ))}
  </div>
)}

<style>
  :root {
    --color-bg: #020617;
    --color-bg-secondary: #0f172a;
    --color-border: rgba(255, 255, 255, 0.08);
    --color-border-hover: rgba(255, 255, 255, 0.12);
    --color-text: #f8fafc;
    --color-text-secondary: #94a3b8;
    --color-text-muted: #64748b;
    --color-accent: #ffffff;
    --color-accent-hover: #a0a0a0;
    --color-accent-light: rgba(35, 128, 244, 0.15);
    --color-success: #10b981;
    --gradient-accent: linear-gradient(135deg, #ffffff 0%, #a0a0a0 100%);
    --gradient-muted: linear-gradient(135deg, rgba(35, 128, 244, 0.1) 0%, rgba(46, 203, 160, 0.05) 100%);
    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.3), 0 2px 4px -2px rgba(0, 0, 0, 0.3);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.3), 0 4px 6px -4px rgba(0, 0, 0, 0.3);
    --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 8px 10px -6px rgba(0, 0, 0, 0.3);
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 14px;
    --radius-xl: 20px;
    --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-base: 250ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: 350ms cubic-bezier(0.4, 0, 0.2, 1);
  }


  .no-posts-section {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 24px;
  }

  .no-posts-content {
    text-align: center;
    max-width: 500px;
