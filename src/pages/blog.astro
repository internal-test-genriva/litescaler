---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getBlogPosts, getCategories, getTags, type BlogPost } from '../lib/payload';

// Configuration
const POSTS_PER_PAGE = 12;
const INITIAL_LOAD = 12;

// Fetch all data from WordPress
const allPosts = await getBlogPosts();
const categories = await getCategories();
const tags = await getTags();

// Sort posts by date
const sortedPosts = [...allPosts].sort((a, b) =>
  new Date(b.date).getTime() - new Date(a.date).getTime()
);

// Get featured post (most recent)
const featuredPost = sortedPosts[0];
const initialPosts = sortedPosts.slice(1, INITIAL_LOAD + 1);
const remainingPosts = sortedPosts.slice(INITIAL_LOAD + 1);

const popularPosts = sortedPosts
  .filter(post => post.seo?.focusKeyword)
  .slice(0, 5);

// Get top categories by count
const topCategories = categories
  .sort((a, b) => b.count - a.count)
  .slice(0, 8);

// Get top tags by count
const topTags = tags
  .sort((a, b) => b.count - a.count)
  .slice(0, 12);

// Helper functions
function formatDate(dateString: string): string {
  return new Date(dateString).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  });
}

function stripHtml(html: string): string {
  if (!html) return '';
  return html.replace(/<[^>]*>/g, '').trim();
}

function decodeHtml(html: string): string {
  if (!html) return '';
  return html
    .replace(/&#8217;/g, "'")
    .replace(/&#8216;/g, "'")
    .replace(/&#8218;/g, "'")
    .replace(/&#8220;/g, '"')
    .replace(/&#8221;/g, '"')
    .replace(/&#8230;/g, '...')
    .replace(/&#8211;/g, '-')
    .replace(/&#8212;/g, '--')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#x27;/g, "'")
    .replace(/&#x2F;/g, '/')
    .replace(/&#39;/g, "'")
    .replace(/&apos;/g, "'");
}

function getReadingTime(content: string): string {
  const text = stripHtml(content);
  const words = text.split(/\s+/).length;
  const minutes = Math.ceil(words / 200);
  return `${minutes} min read`;
}

function getExcerpt(content: string, htmlExcerpt: string, title: string, length: number = 160): string {
  if (htmlExcerpt) {
    let text = stripHtml(htmlExcerpt);
    if (title && text.toLowerCase().startsWith(title.toLowerCase())) {
      text = text.substring(title.length).trim();
    }
    if (text.length <= length) return text;
    return text.substring(0, length).trim() + '...';
  }
  const text = stripHtml(content);
  if (text.length <= length) return text;
  return text.substring(0, length).trim() + '...';
}

function getFeaturedImage(post: BlogPost): string {
  return post.featuredImage || '';
}

function getCategoryNames(post: BlogPost): string[] {
  return post.categories || [];
}

// Get recent posts (excluding featured)
const recentPosts = sortedPosts
  .slice(1, 6);

// Get monthly archives
const archives = sortedPosts.reduce((acc: {date: string, count: number}[], post) => {
  const date = new Date(post.date);
  const key = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
  const existing = acc.find(a => a.date === key);
  if (existing) {
    existing.count++;
  } else {
    acc.push({ date: key, count: 1 });
  }
  return acc;
}, []).sort((a, b) => b.date.localeCompare(a.date)).slice(0, 6);

// Helper function to format archive date
function formatArchiveDate(dateStr: string): string {
  const [year, month] = dateStr.split('-');
  const date = new Date(parseInt(year), parseInt(month) - 1);
  return date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
}

// Serialize posts data for client-side
// We slice(1) to skip the featured post showing in the hero, meaning
// postsData contains exactly what should be paginated in the grid below.
const postsData = sortedPosts.slice(1).map(post => ({
  slug: post.slug,
  title: post.title,
  content: post.content,
  excerpt: post.excerpt,
  date: post.date,
  featuredImage: getFeaturedImage(post),
  categories: getCategoryNames(post),
  readingTime: getReadingTime(post.content)
}));
---

<BaseLayout title="Blog - LiteScaler">
  <!-- Hero Featured Section -->
  {featuredPost && (
    <section class="hero-section">
      <div class="hero-bg">
        {getFeaturedImage(featuredPost) && (
          <img 
            src={getFeaturedImage(featuredPost)} 
            alt="" 
            class="hero-image"
            loading="eager"
          />
        )}
        <div class="hero-gradient"></div>
      </div>
      
      <div class="hero-container">
        <div class="hero-content">
          <div class="hero-header">
            <span class="hero-badge">
              <span class="badge-dot"></span>
              Latest Article
            </span>
            <span class="hero-date">{formatDate(featuredPost.date)}</span>
          </div>
          
          <h1 class="hero-title">
            <a href={`/blog/${featuredPost.slug}`}><span set:html={decodeHtml(featuredPost.title)} /></a>
          </h1>
          
          <p class="hero-excerpt">
            {getExcerpt(featuredPost.content, featuredPost.excerpt, featuredPost.title, 200)}
          </p>
          
          <div class="hero-meta-row">
            <span class="hero-category">
              {getCategoryNames(featuredPost)[0] || 'Article'}
            </span>
            <span class="hero-readtime">{getReadingTime(featuredPost.content)}</span>
          </div>
          
          <a href={`/blog/${featuredPost.slug}`} class="hero-cta">
            Read Article
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
        
        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-value">{sortedPosts.length}</span>
            <span class="stat-label">Articles</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-value">{topCategories.length}</span>
            <span class="stat-label">Categories</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-value">{topTags.length}+</span>
            <span class="stat-label">Topics</span>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Main Content -->
  <main class="main-content">
    <div class="content-wrapper">
      
      <!-- Section Header -->
      <header class="section-header">
        <div class="header-left">
          <h2 class="section-title">Latest Stories</h2>
          <p class="section-subtitle">Insights, tutorials, and updates from the team</p>
        </div>
        <div class="header-right">
          <div class="header-info">
            <span class="info-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2v20M2 12h20"/>
              </svg>
              Fresh content added weekly
            </span>
          </div>
        </div>
      </header>

      <!-- Posts Grid -->
      <div class="posts-grid" id="posts-grid">
        <!-- The posts will be rendered by client-side JS immediately on load to support pagination accurately -->
      </div>
      
      <!-- Loading Skeleton -->
      <div class="skeleton-grid" id="skeleton-grid" style="display: none;">
        {[1, 2, 3, 4, 5, 6].map((i) => (
          <article class="skeleton-card">
            <div class="skeleton-image"></div>
            <div class="skeleton-content">
              <div class="skeleton-meta"></div>
              <div class="skeleton-title"></div>
              <div class="skeleton-excerpt"></div>
              <div class="skeleton-footer"></div>
            </div>
          </article>
        ))}
      </div>

      <!-- Load More / Pagination -->
      <div class="pagination-area" id="pagination-area">
        <button class="pagination-btn" id="prev-btn" style="display: none;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          Previous
        </button>
        <span class="pagination-info" id="pagination-info">
          Page 1
        </span>
        <button class="pagination-btn" id="next-btn" style="display: none;">
          Next
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Sidebar -->
    <aside class="sidebar">
      <!-- Newsletter Widget -->
      <div class="widget newsletter-card">
        <div class="newsletter-header">
          <div class="newsletter-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <div class="newsletter-title-group">
            <h3>Stay Updated</h3>
            <p>Get the latest posts delivered to your inbox</p>
          </div>
        </div>
        <form class="newsletter-form" onsubmit="event.preventDefault();">
          <input type="email" placeholder="Enter your email" class="newsletter-input" required />
          <button type="submit" class="newsletter-btn">
            <span>Subscribe</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        </form>
        <p class="newsletter-note">No spam, unsubscribe anytime</p>
      </div>

      <!-- Trending Widget -->
      <div class="widget trending-card">
        <div class="widget-header">
          <h3>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
              <polyline points="17 6 23 6 23 12"/>
            </svg>
            Trending
          </h3>
        </div>
        <ul class="trending-list">
          {popularPosts.length > 0 ? popularPosts.map((post, index) => (
            <li class="trending-item">
              <a href={`/blog/${post.slug}`} class="trending-link">
                <span class="trending-index">{String(index + 1).padStart(2, '0')}</span>
                <div class="trending-info">
                  <h4><span set:html={decodeHtml(post.title)} /></h4>
                  <span class="trending-meta">{getReadingTime(post.content)}</span>
                </div>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="trending-arrow">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </li>
          )) : (
            <>
              {[
                { title: "Web Hosting in 2026: Complete Guide", meta: "8 min read" },
                { title: "WordPress Optimization Best Practices", meta: "6 min read" },
                { title: "Server Security Essentials", meta: "5 min read" },
                { title: "VPS vs Shared Hosting: What's Best", meta: "7 min read" },
                { title: "SSL Certificates Explained", meta: "4 min read" }
              ].map((item, i) => (
                <li class="trending-item">
                  <a href="#" class="trending-link">
                    <span class="trending-index">{String(i + 1).padStart(2, '0')}</span>
                    <div class="trending-info">
                      <h4>{item.title}</h4>
                      <span class="trending-meta">{item.meta}</span>
                    </div>
                  </a>
                </li>
              ))}
            </>
          )}
        </ul>
      </div>

      <!-- Categories Widget -->
      <div class="widget categories-card">
        <div class="widget-header">
          <h3>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7"/>
              <rect x="14" y="3" width="7" height="7"/>
              <rect x="14" y="14" width="7" height="7"/>
              <rect x="3" y="14" width="7" height="7"/>
            </svg>
            Categories
          </h3>
        </div>
        <ul class="categories-list">
          {topCategories.length > 0 ? topCategories.map((cat) => (
            <li>
              <a href={`/blog/category/${cat.slug}`} class="category-link">
                <span class="category-name">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                  </svg>
                  {cat.name}
                </span>
                <span class="category-arrow">→</span>
              </a>
            </li>
          )) : (
            <>
              {['Hosting Guides', 'WordPress', 'Performance', 'Security', 'VPS'].map((cat) => (
                <li>
                  <a href="#" class="category-link">
                    <span class="category-name">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                      </svg>
                      {cat}
                    </span>
                    <span class="category-arrow">→</span>
                  </a>
                </li>
              ))}
            </>
          )}
        </ul>
      </div>

      <!-- Tags Widget -->
      <div class="widget tags-card">
        <div class="widget-header">
          <h3>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
              <line x1="7" y1="7" x2="7.01" y2="7"/>
            </svg>
            Popular Tags
          </h3>
        </div>
        <div class="tags-cloud">
          {topTags.length > 0 ? topTags.map((tag) => (
            <a href={`/blog/tag/${tag.slug}`} class="tag-link">{tag.name}</a>
          )) : (
            <>
              {['Web Hosting', 'WordPress', 'Performance', 'Security', 'VPS', 'SSL', 'DNS', 'Server'].map((tag) => (
                <a href="#" class="tag-link">{tag}</a>
              ))}
            </>
          )}
        </div>
      </div>

      <!-- CTA Widget -->
      <div class="widget cta-card">
        <div class="cta-bg-pattern"></div>
        <div class="cta-content">
          <span class="cta-badge">Special Offer</span>
          <h3>Get 82% OFF Hosting</h3>
          <p>Lightning-fast NVMe hosting with global CDN</p>
          <a href="/hosting" class="cta-btn">
            View Plans
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </aside>
  </main>

</BaseLayout>

<!-- Client-side pagination script -->
<script define:vars={{ postsData, POSTS_PER_PAGE }}>
  // Decode HTML entities on client side
  function decodeHtmlEntity(html) {
    if (!html) return '';
    return html
      .replace(/&#8217;/g, "'")
      .replace(/&#8216;/g, "'")
      .replace(/&#8218;/g, "'")
      .replace(/&#8220;/g, '"')
      .replace(/&#8221;/g, '"')
      .replace(/&#8230;/g, '...')
      .replace(/&#8211;/g, '-')
      .replace(/&#8212;/g, '--')
      .replace(/&amp;/g, '&')
      .replace(/&lt;/g, '<')
      .replace(/&gt;/g, '>')
      .replace(/&quot;/g, '"')
      .replace(/&#x27;/g, "'")
      .replace(/&#x2F;/g, '/')
      .replace(/&#39;/g, "'")
      .replace(/&apos;/g, "'");
  }

  document.addEventListener('DOMContentLoaded', () => {
    // Initialize everything

    // Call finding buttons code below (it uses force querySelectors)
    // Force find buttons using querySelector to bypass any Astro ID scoping issues if they exist
    const prevBtn = document.querySelector('#prev-btn');
    const nextBtn = document.querySelector('#next-btn');
    const pageInfo = document.querySelector('#pagination-info');
    const postsGrid = document.querySelector('#posts-grid');
    const skeletonGrid = document.querySelector('#skeleton-grid');
    
    let currentPage = 1;
    // We already sliced out the featured post, so postsData is EXACTLY the pool for the grid.
    const totalPages = Math.max(1, Math.ceil(postsData.length / POSTS_PER_PAGE));
    
    function updatePaginationUI() {
      if (totalPages <= 1) {
        if (prevBtn) prevBtn.style.display = 'none';
        if (nextBtn) nextBtn.style.display = 'none';
        if (pageInfo) pageInfo.style.display = 'none';
        return;
      }
      
      if (pageInfo) pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
      
      if (prevBtn) {
        if (currentPage > 1) {
          prevBtn.style.display = 'flex';
        } else {
          prevBtn.style.display = 'none';
        }
      }
      
      if (nextBtn) {
        if (currentPage < totalPages) {
          nextBtn.style.display = 'flex';
        } else {
          nextBtn.style.display = 'none';
        }
      }
    }
    
    // Initial UI Setup
    updatePaginationUI();
    
    // Create post card HTML
    function createPostCard(post, index) {
      const card = document.createElement('article');
      card.className = 'post-card';
      card.style.setProperty('--card-index', index);
      card.style.animationDelay = `${(index % 3) * 0.1}s`;
      
      const title = decodeHtmlEntity(post.title);
      const cat = post.categories && post.categories.length > 0 ? post.categories[0] : 'Article';
      const formattedDate = new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
      const imgHtml = post.featuredImage 
        ? `<img src="${post.featuredImage}" alt="" loading="lazy" class="card-image" />`
        : `<div class="card-placeholder" style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; background: #f1f5f9;">
             <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width: 48px; height: 48px; opacity: 0.5;">
               <rect x="3" y="3" width="18" height="18" rx="2"/>
               <circle cx="8.5" cy="8.5" r="1.5"/>
               <polyline points="21 15 16 10 5 21"/>
             </svg>
           </div>`;
           
      card.innerHTML = `
        <a href="/blog/${post.slug}" class="card-image-link">
          <div class="card-image-wrapper">
            ${imgHtml}
            <div class="image-overlay"></div>
          </div>
        </a>
        
        <div class="card-content">
          <div class="card-meta">
            <span class="card-category">${cat}</span>
            <time datetime="${post.date}">${formattedDate}</time>
          </div>

          <h3 class="card-title">
            <a href="/blog/${post.slug}">${title}</a>
          </h3>

          <p class="card-excerpt">${post.excerpt || ''}</p>

          <div class="card-footer">
            <span class="card-readtime">${post.readingTime}</span>
            <a href="/blog/${post.slug}" class="card-link">
              Read more
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      `;
      
      return card;
    }
    
    // Load a specific page
    async function loadPage(page) {
      if (page < 1 || page > totalPages) return;
      
      currentPage = page;
      updatePaginationUI();
      
      // Clear grid and show skeleton
      postsGrid.innerHTML = '';
      skeletonGrid.style.display = 'grid';
      window.scrollTo({ top: document.querySelector('.main-content').offsetTop - 100, behavior: 'smooth' });
      
      // Simulate network delay for UX
      await new Promise(resolve => setTimeout(resolve, 300));
      skeletonGrid.style.display = 'none';
      
      // The array 'postsData' actually has all posts minus the hero post.
      // E.g., if there are 15 total posts, postsData has 14.
      // So page 1 showed index 0..11, but wait! The server generated the first initialPosts block (up to 12).
      // Let's use postsData directly since it contains everything in the grid.
      const start = (currentPage - 1) * POSTS_PER_PAGE;
      const end = start + POSTS_PER_PAGE;
      const pagePosts = postsData.slice(start, end);
      
      pagePosts.forEach((post, index) => {
        const card = createPostCard(post, index);
        card.style.opacity = '0';
        card.style.transform = 'translateY(20px)';
        postsGrid.appendChild(card);
        
        requestAnimationFrame(() => {
          card.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
          card.style.opacity = '1';
          card.style.transform = 'translateY(0)';
        });
      });
    }
    
    // Attach event listeners using delegated document events to be absolutely sure they bind
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (target.closest('#prev-btn')) {
        loadPage(currentPage - 1);
      } else if (target.closest('#next-btn')) {
        loadPage(currentPage + 1);
      }
    });
    
    // Initial Render of First Page
    loadPage(1);
  });
</script>

<style is:global>
  /* ==========================================================================
     Blog Page — Redesigned to match LiteScaler light theme
     Poppins font · #0f172a text · #2380F4 accent · #ffffff backgrounds
     ========================================================================== */

  /* ---- tokens ---- */
  :root {
    --blog-white:   #ffffff;
    --blog-off:     #f8fafc;
    --blog-border:  rgba(15, 23, 42, 0.08);
    --blog-text:    #0f172a;
    --blog-sub:     #475569;
    --blog-muted:   #94a3b8;
    --blog-accent:  #2380F4;
    --blog-accent2: #1d6ed8;
    --blog-radius:  16px;
    --blog-tr:      0.25s ease;
  }


  
  /* ================================================================
     BASE LAYOUT
     ================================================================ */
  .main-content {
    background: var(--blog-white);
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 48px;
    max-width: 1400px;
    margin: 0 auto;
    padding: 64px 40px 100px;
    font-family: 'Poppins', sans-serif;
  }

  .main-content .content-wrapper {
    min-width: 0;
  }

  .main-content .sidebar {
    position: sticky;
    top: 100px;
    height: fit-content;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  
  /* ================================================================
     HERO — Clean light-theme split layout
     ================================================================ */
  .hero-section {
    background: var(--blog-white);
    padding-top: 100px;
    padding-bottom: 0;
    position: relative;
    overflow: hidden;
    font-family: 'Poppins', sans-serif;
  }

  /* The hero background image is repurposed as a subtle tinted right panel */
  .hero-bg {
    position: absolute;
    top: 0; right: 0;
    width: 50%;
    height: 100%;
    z-index: 0;
    border-radius: 0;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    opacity: 0.08;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, #ffffff 40%, rgba(255,255,255,0) 100%);
  }

  .hero-container {
    position: relative;
    z-index: 2;
    max-width: 1400px;
    margin: 0 auto;
    padding: 56px 40px 64px;
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 56px;
    align-items: center;
  }

  .hero-content { width: 100%; }

  .hero-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 22px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 14px;
    background: linear-gradient(135deg, #2380F4, #1d6ed8);
    color: #fff;
    font-family: 'Poppins', sans-serif;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-radius: 50px;
  }

  .badge-dot {
    width: 5px;
    height: 5px;
    background: #fff;
    border-radius: 50%;
    animation: blogPulse 2s ease-in-out infinite;
  }

  @keyframes blogPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(1.3); }
  }

  .hero-date {
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: var(--blog-muted);
  }

  .hero-title {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(28px, 3.5vw, 46px);
    font-weight: 700;
    color: var(--blog-text);
    line-height: 1.15;
    letter-spacing: -0.025em;
    margin: 0 0 20px;
  }

  .hero-title a {
    color: var(--blog-text);
    text-decoration: none;
    transition: color var(--blog-tr);
  }

  .hero-title a:hover { color: var(--blog-accent); }

  .hero-excerpt {
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    font-weight: 500;
    color: var(--blog-sub);
    line-height: 1.75;
    margin: 0 0 28px;
    max-width: 580px;
  }

  .hero-meta-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;
  }

  .hero-category {
    padding: 5px 12px;
    background: rgba(35, 128, 244, 0.08);
    color: var(--blog-accent);
    font-family: 'Poppins', sans-serif;
    font-size: 11px;
    font-weight: 700;
    border-radius: 6px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1px solid rgba(35, 128, 244, 0.2);
  }

  .hero-readtime {
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: var(--blog-muted);
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    background: var(--blog-accent);
    color: #fff;
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 15px;
    border-radius: 12px;
    text-decoration: none;
    transition: all var(--blog-tr);
    box-shadow: 0 8px 24px rgba(35, 128, 244, 0.28);
  }

  .hero-cta:hover {
    background: var(--blog-accent2);
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(35, 128, 244, 0.38);
  }

  .hero-cta svg {
    width: 18px; height: 18px;
    transition: transform var(--blog-tr);
  }

  .hero-cta:hover svg { transform: translateX(4px); }

  /* Stats panel — right column of hero */
  .hero-stats {
    display: flex;
    flex-direction: column;
    gap: 0;
    background: var(--blog-white);
    border: 1px solid var(--blog-border);
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(15, 23, 42, 0.08);
    align-items: stretch;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 28px 24px;
    border-bottom: 1px solid var(--blog-border);
  }

  .stat-item:last-child { border-bottom: none; }

  .stat-value {
    display: block;
    font-family: 'Poppins', sans-serif;
    font-size: 36px;
    font-weight: 800;
    color: var(--blog-accent);
    line-height: 1;
    margin-bottom: 6px;
  }

  .stat-label {
    font-family: 'Poppins', sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: var(--blog-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .stat-divider { display: none; }

  /* ================================================================
     CONTENT LAYOUT
     ================================================================ */
  .content-wrapper { width: 100%; }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 36px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--blog-border);
  }

  .header-left { flex: 1; }

  .section-title {
    font-family: 'Poppins', sans-serif;
    font-size: 26px;
    font-weight: 700;
    color: var(--blog-text);
    margin: 0 0 6px;
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--blog-sub);
    margin: 0;
  }

  .header-info { display: flex; align-items: center; }

  .info-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    background: rgba(35, 128, 244, 0.07);
    border: 1px solid rgba(35, 128, 244, 0.18);
    border-radius: 50px;
    font-family: 'Poppins', sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: var(--blog-accent);
  }

  .info-badge svg { width: 13px; height: 13px; }
  
  /* ================================================================
     POSTS GRID
     ================================================================ */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .post-card {
    background: var(--blog-white);
    border: 1px solid var(--blog-border);
    border-radius: var(--blog-radius);
    overflow: hidden;
    transition: transform var(--blog-tr), box-shadow var(--blog-tr), border-color var(--blog-tr);
    animation: blogFadeUp 0.45s ease forwards;
    animation-delay: calc(var(--card-index, 0) * 0.06s);
    opacity: 0;
    font-family: 'Poppins', sans-serif;
  }

  @keyframes blogFadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .post-card:hover {
    border-color: rgba(35, 128, 244, 0.3);
    transform: translateY(-5px);
    box-shadow: 0 20px 48px rgba(15, 23, 42, 0.1);
  }

  .card-image-link { display: block; overflow: hidden; }

  .card-image-wrapper {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #f1f5f9;
  }

  .card-image {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .post-card:hover .card-image { transform: scale(1.06); }

  .card-placeholder {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    background: #f1f5f9;
  }

  .card-placeholder svg { width: 40px; height: 40px; color: #cbd5e1; }

  .image-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(35, 128, 244, 0.12) 0%, transparent 60%);
    opacity: 0;
    transition: opacity var(--blog-tr);
  }

  .post-card:hover .image-overlay { opacity: 1; }

  .card-content { padding: 20px 20px 22px; }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .card-category {
    font-family: 'Poppins', sans-serif;
    font-size: 10px;
    font-weight: 700;
    color: var(--blog-accent);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    background: rgba(35, 128, 244, 0.08);
    padding: 3px 8px;
    border-radius: 4px;
  }

  .card-meta time {
    font-family: 'Poppins', sans-serif;
    font-size: 11px;
    font-weight: 500;
    color: var(--blog-muted);
  }
  
  .card-title {
    font-family: 'Poppins', sans-serif;
    font-size: 17px;
    font-weight: 700;
    color: var(--blog-text);
    line-height: 1.4;
    margin: 0 0 12px;
    letter-spacing: -0.01em;
  }

  .card-title a {
    color: inherit;
    text-decoration: none;
    transition: color var(--blog-tr);
  }

  .card-title a:hover { color: var(--blog-accent); }

  .card-excerpt {
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--blog-sub);
    line-height: 1.65;
    margin: 0 0 18px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top: 1px solid var(--blog-border);
  }

  .card-readtime {
    font-family: 'Poppins', sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: var(--blog-muted);
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: var(--blog-accent);
    text-decoration: none;
    transition: all var(--blog-tr);
  }

  .card-link:hover {
    color: var(--blog-accent2);
    gap: 10px;
  }

  .card-link svg { width: 16px; height: 16px; }

  /* ==========================================================================
     Skeleton Loading
     ========================================================================== */
  .skeleton-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
  }

  .skeleton-card {
    background: var(--blog-white);
    border: 1px solid var(--blog-border);
    border-radius: var(--blog-radius);
    overflow: hidden;
  }

  .skeleton-image {
    aspect-ratio: 16 / 10;
    background: linear-gradient(90deg, #f1f5f9 0%, #e2e8f0 50%, #f1f5f9 100%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
  }

  @keyframes shimmer {
    from { background-position: 200% 0; }
    to   { background-position: -200% 0; }
  }

  .skeleton-content { padding: 22px; }

  .skeleton-meta {
    height: 14px; width: 60%;
    background: #e2e8f0; border-radius: 4px; margin-bottom: 14px;
  }

  .skeleton-title {
    height: 22px; width: 90%;
    background: #e2e8f0; border-radius: 4px; margin-bottom: 12px;
  }

  .skeleton-excerpt {
    height: 16px; width: 100%;
    background: #e2e8f0; border-radius: 4px; margin-bottom: 8px;
  }

  .skeleton-excerpt:nth-child(3) { width: 75%; }

  .skeleton-footer {
    height: 16px; width: 40%;
    background: #e2e8f0; border-radius: 4px; margin-top: 16px;
  }

  /* ==========================================================================
     Pagination Buttons
     ========================================================================== */
  .pagination-area {
    margin-top: 60px;
    padding-top: 40px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    width: 100%;
  }

  .pagination-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 13px 28px;
    background: var(--blog-accent);
    border: none;
    color: #ffffff;
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    font-weight: 600;
    border-radius: 12px;
    cursor: pointer;
    transition: all var(--blog-tr);
    box-shadow: 0 6px 20px rgba(35, 128, 244, 0.28);
  }

  .pagination-btn:hover {
    background: var(--blog-accent2);
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(35, 128, 244, 0.38);
  }

  .pagination-btn:active { transform: translateY(0); }

  .pagination-btn svg {
    width: 18px; height: 18px;
    transition: transform var(--blog-tr);
  }

  .pagination-btn#prev-btn:hover svg { transform: translateX(-4px); }
  .pagination-btn#next-btn:hover svg { transform: translateX(4px); }

  .pagination-info {
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--blog-sub);
  }

  /* ==========================================================================
     Sidebar
     ========================================================================== */
  .sidebar {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .widget {
    background: var(--blog-white);
    border: 1px solid var(--blog-border);
    border-radius: var(--blog-radius);
    overflow: hidden;
    transition: border-color var(--blog-tr), box-shadow var(--blog-tr);
    font-family: 'Poppins', sans-serif;
  }

  .widget:hover {
    border-color: rgba(35, 128, 244, 0.22);
    box-shadow: 0 8px 28px rgba(15, 23, 42, 0.07);
  }

  .widget-header {
    padding: 18px 20px 14px;
    border-bottom: 1px solid var(--blog-border);
  }

  .widget-header h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: var(--blog-text);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .widget-header svg {
    width: 17px; height: 17px;
    color: var(--blog-accent);
  }

  /* Newsletter Widget */
  .newsletter-card {
    background: var(--blog-white);
    border-color: rgba(35, 128, 244, 0.18);
  }

  .newsletter-header {
    display: flex;
    gap: 14px;
    padding: 20px;
    border-bottom: 1px solid var(--blog-border);
    align-items: flex-start;
  }

  .newsletter-icon {
    width: 44px; height: 44px;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, #2380F4, #1d6ed8);
    border-radius: 10px;
    flex-shrink: 0;
  }

  .newsletter-icon svg { width: 22px; height: 22px; color: #fff; }

  .newsletter-title-group h3 {
    font-family: 'Poppins', sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: var(--blog-text);
    margin: 0 0 4px;
  }

  .newsletter-title-group p {
    font-family: 'Poppins', sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: var(--blog-sub);
    margin: 0;
  }

  .newsletter-form {
    padding: 16px 20px 8px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .newsletter-input {
    width: 100%;
    padding: 12px 14px;
    background: var(--blog-off);
    border: 1px solid var(--blog-border);
    border-radius: 10px;
    color: var(--blog-text);
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    font-weight: 500;
    outline: none;
    transition: border-color var(--blog-tr), background var(--blog-tr);
    box-sizing: border-box;
  }

  .newsletter-input::placeholder { color: var(--blog-muted); }

  .newsletter-input:focus {
    border-color: var(--blog-accent);
    background: var(--blog-white);
    box-shadow: 0 0 0 3px rgba(35, 128, 244, 0.1);
  }

  .newsletter-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 18px;
    background: linear-gradient(135deg, #2380F4, #1d6ed8);
    border: none;
    border-radius: 10px;
    color: #fff;
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all var(--blog-tr);
    box-shadow: 0 4px 14px rgba(35, 128, 244, 0.3);
  }

  .newsletter-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(35, 128, 244, 0.4);
  }

  .newsletter-btn svg {
    width: 15px; height: 15px;
    transition: transform var(--blog-tr);
  }

  .newsletter-btn:hover svg { transform: translateX(3px); }

  .newsletter-note {
    padding: 0 20px 16px;
    margin: 0;
    font-family: 'Poppins', sans-serif;
    font-size: 11px;
    font-weight: 500;
    color: var(--blog-muted);
    text-align: center;
  }

  /* Trending Widget */
  .trending-list { list-style: none; padding: 6px 0; margin: 0; }

  .trending-item { padding: 0 16px; }

  .trending-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    text-decoration: none;
    border-bottom: 1px solid var(--blog-border);
    transition: all var(--blog-tr);
  }

  .trending-item:last-child .trending-link { border-bottom: none; }

  .trending-link:hover { gap: 16px; }

  .trending-link:hover .trending-index { color: var(--blog-accent); }

  .trending-index {
    font-family: 'Poppins', sans-serif;
    font-size: 12px;
    font-weight: 700;
    color: var(--blog-muted);
    min-width: 26px;
    transition: color var(--blog-tr);
  }

  .trending-info { flex: 1; min-width: 0; }

  .trending-info h4 {
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: var(--blog-text);
    margin: 0 0 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color var(--blog-tr);
  }
  
  .trending-link:hover .trending-info h4 { color: var(--blog-accent); }

  .trending-meta {
    font-family: 'Poppins', sans-serif;
    font-size: 11px;
    font-weight: 500;
    color: var(--blog-muted);
  }

  .trending-arrow {
    width: 15px; height: 15px;
    color: var(--blog-muted);
    opacity: 0;
    transform: translateX(-5px);
    transition: all var(--blog-tr);
  }

  .trending-link:hover .trending-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--blog-accent);
  }

  /* Categories Widget */
  .categories-list { list-style: none; padding: 6px 0; margin: 0; }

  .category-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    text-decoration: none;
    color: var(--blog-sub);
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    font-weight: 500;
    transition: all var(--blog-tr);
    border-radius: 8px;
    margin: 2px 8px;
  }

  .category-link:hover {
    background: rgba(35, 128, 244, 0.06);
    color: var(--blog-accent);
    transform: translateX(4px);
  }

  .category-name {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .category-name svg {
    width: 16px; height: 16px;
    color: var(--blog-accent);
    opacity: 0.65;
    transition: all var(--blog-tr);
  }

  .category-link:hover .category-name svg {
    opacity: 1;
    transform: scale(1.1);
  }

  .category-arrow {
    font-size: 14px;
    color: var(--blog-muted);
    opacity: 0;
    transform: translateX(-6px);
    transition: all var(--blog-tr);
  }

  .category-link:hover .category-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--blog-accent);
  }

  /* Tags Widget */
  .tags-card { padding: 20px; }

  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag-link {
    padding: 7px 13px;
    background: var(--blog-off);
    color: var(--blog-sub);
    font-family: 'Poppins', sans-serif;
    font-size: 12px;
    font-weight: 500;
    border-radius: 8px;
    text-decoration: none;
    border: 1px solid var(--blog-border);
    transition: all var(--blog-tr);
  }

  .tag-link:hover {
    background: rgba(35, 128, 244, 0.08);
    color: var(--blog-accent);
    border-color: rgba(35, 128, 244, 0.25);
    transform: translateY(-2px);
  }

  /* CTA Widget */
  .cta-card {
    position: relative;
    background: linear-gradient(135deg, #1e3a8a 0%, #2380F4 60%, #3b82f6 100%);
    border-color: transparent;
    overflow: hidden;
  }

  .cta-bg-pattern {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 20%, rgba(255,255,255,0.12) 0%, transparent 50%),
      radial-gradient(circle at 80% 80%, rgba(255,255,255,0.08) 0%, transparent 50%);
  }

  .cta-content {
    position: relative;
    padding: 28px 24px;
    text-align: center;
  }

  .cta-badge {
    display: inline-block;
    padding: 5px 13px;
    background: rgba(255, 255, 255, 0.2);
    color: #fff;
    font-family: 'Poppins', sans-serif;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    border-radius: 50px;
    margin-bottom: 14px;
    border: 1px solid rgba(255,255,255,0.3);
  }

  .cta-content h3 {
    font-family: 'Poppins', sans-serif;
    font-size: 20px;
    font-weight: 800;
    color: #fff;
    margin: 0 0 10px;
    letter-spacing: -0.02em;
  }

  .cta-content p {
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
    margin: 0 0 22px;
    line-height: 1.6;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 24px;
    background: #fff;
    color: var(--blog-accent);
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 14px;
    border-radius: 10px;
    text-decoration: none;
    transition: all var(--blog-tr);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }

  .cta-btn:hover {
    background: var(--blog-off);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }

  .cta-btn svg {
    width: 16px; height: 16px;
    transition: transform var(--blog-tr);
