---
import BaseLayout from '../layouts/BaseLayout.astro';
import { 
  Shield, FileText, RefreshCw, Cookie, Scale, AlertCircle, Mail, 
  Check, X, User, CreditCard, Monitor, Activity, Globe, Lock, ExternalLink
} from 'lucide-react';
import '../styles/pages/legal.css';
---

<BaseLayout title="Legal — LiteScaler">

  <!-- HERO SECTION -->
  <section class="lg-hero">
    <div class="lg-container">
      <h1 class="lg-main-title">Our Policies, Your Peace of Mind</h1>
      <p class="lg-subline">Transparency is at our core. Here's everything you need to know about how we protect your data, our service terms, and your rights as a customer.</p>
    </div>
  </section>

  <!-- LAYOUT WRAPPER -->
  <div class="lg-layout-wrapper lg-container">

    <!-- Sidebar Navigation -->
    <aside class="lg-sidebar">
      <div class="lg-sidebar-sticky">
        <h3 class="lg-sidebar-title">Contents</h3>
        <nav class="lg-sidebar-nav">
          <a href="#privacy-policy" class="lg-sidebar-link active">
            <Lock size={18} />
            Privacy Policy
          </a>
          <a href="#terms-of-service" class="lg-sidebar-link">
            <FileText size={18} />
            Terms of Service
          </a>
          <a href="#refund-policy" class="lg-sidebar-link">
            <RefreshCw size={18} />
            Refund Policy
          </a>
          <a href="#cookie-policy" class="lg-sidebar-link">
            <Cookie size={18} />
            Cookie Policy
          </a>
          <a href="#dmca-policy" class="lg-sidebar-link">
            <Scale size={18} />
            DMCA Policy
          </a>
          <a href="#disclaimer" class="lg-sidebar-link">
            <Shield size={18} />
            Disclaimer
          </a>
          <a href="#contact-us" class="lg-sidebar-link">
            <Mail size={18} />
            Contact Us
          </a>
        </nav>
      </div>
    </aside>

    <!-- Main Legal Content -->
    <main class="lg-content">
      
      <!-- Privacy Policy -->
      <article class="lg-card" id="privacy-policy">
        <div class="lg-card-header">
          <div class="lg-card-icon">
            <Lock size={28} />
          </div>
          <div class="lg-card-title">
            <h2>Privacy Policy</h2>
            <span class="lg-last-updated">Last Updated: February 2026</span>
          </div>
        </div>
        <div class="lg-card-body">
          <p class="lg-intro-text">
            Welcome to LiteScaler. Your privacy is of utmost importance to us. This Privacy Policy outlines how we collect, use, and protect your personal data when you interact with our website and services.
          </p>

          <div class="lg-policy-section">
            <h3>1. Introduction</h3>
            <p>By using our services, you agree to the collection and use of information in accordance with this policy. We ensure that your data is handled with the highest level of security and in compliance with global standards.</p>
          </div>

          <div class="lg-policy-section">
            <h3>2. Information We Collect</h3>
            <p>When you use our website or services, we may collect the following data points to better serve you:</p>
            <div class="lg-info-grid">
              <div class="lg-info-item">
                <div class="lg-hi-icon"><User size={20} /></div>
                <div class="lg-info-content">
                  <h4>Personal Identification</h4>
                  <p>Name, Email, Phone, and Billing Address</p>
                </div>
              </div>
              <div class="lg-info-item">
                <div class="lg-hi-icon"><CreditCard size={20} /></div>
                <div class="lg-info-content">
                  <h4>Payment Info</h4>
                  <p>Secure third-party payment processing</p>
                </div>
              </div>
            </div>
          </div>

          <div class="lg-policy-section">
            <h3>3. Usage & Protection</h3>
            <p>Data is used for service provision, billing, and communication. We implement industry-standard encryption to protect your data.</p>
          </div>

          <div class="lg-highlight-box">
            <div class="lg-hi-blue"><Shield size={24} /></div>
            <div class="lg-hi-content">
              <h4>Security First</h4>
              <p>We use end-to-end encryption for all sensitive data transfers. Your trust is our most valuable asset.</p>
            </div>
          </div>
        </div>
      </article>

      <!-- Terms of Service -->
      <article class="lg-card" id="terms-of-service">
        <div class="lg-card-header">
          <div class="lg-card-icon">
            <FileText size={28} />
          </div>
          <div class="lg-card-title">
            <h2>Terms of Service</h2>
            <span class="lg-last-updated">Last Updated: February 2026</span>
          </div>
        </div>
        <div class="lg-card-body">
          <p class="lg-intro-text">
            These Terms govern your use of LiteScaler hosting services. By using our platform, you agree to these legal conditions.
          </p>

          <div class="lg-policy-section">
            <h3>1. Service Eligibility</h3>
            <p>Our services are available to individuals and business entities. You are responsible for account security and accurate information.</p>
          </div>

          <div class="lg-policy-section">
            <h3>2. Acceptable Use</h3>
            <ul class="lg-policy-list">
              <li><Check size={16} class="lg-check-icon" /><span>No illegal content or activities allowed.</span></li>
              <li><Check size={16} class="lg-check-icon" /><span>Phishing, spamming, and hacking are strictly prohibited.</span></li>
              <li><Check size={16} class="lg-check-icon" /><span>Fair usage of server resources.</span></li>
            </ul>
          </div>

          <div class="lg-highlight-box">
            <div class="lg-hi-blue"><Activity size={24} /></div>
            <div class="lg-hi-content">
              <h4>99.9% Uptime Guarantee</h4>
              <p>We stand by our hardware and network reliability. Our SLA ensures your site is always online when it matters most.</p>
            </div>
          </div>
        </div>
      </article>

      <!-- Refund Policy -->
      <article class="lg-card" id="refund-policy">
        <div class="lg-card-header">
          <div class="lg-card-icon">
            <RefreshCw size={28} />
          </div>
          <div class="lg-card-title">
            <h2>Refund Policy</h2>
            <span class="lg-last-updated">Last Updated: February 2026</span>
          </div>
        </div>
        <div class="lg-card-body">
          <p class="lg-intro-text">We value our customers' satisfaction and offer a clear refund path.</p>
          <div class="lg-highlight-box">
            <div class="lg-hi-blue"><CreditCard size={24} /></div>
            <div class="lg-hi-content">
              <h4>7-Day Money Back</h4>
              <p>New customers enjoy a full refund period within the first 7 days of hosting service purchase.</p>
            </div>
          </div>
          <div class="lg-policy-section">
            <h3>Eligibility</h3>
            <p>Refunds apply to first-time hosting customers only. Domain registrations and license fees are non-refundable.</p>
          </div>
        </div>
      </article>

      <!-- Cookie Policy -->
      <article class="lg-card" id="cookie-policy">
        <div class="lg-card-header">
          <div class="lg-card-icon">
            <Cookie size={28} />
          </div>
          <div class="lg-card-title">
            <h2>Cookie Policy</h2>
            <span class="lg-last-updated">Last Updated: February 2026</span>
          </div>
        </div>
        <div class="lg-card-body">
          <p class="lg-intro-text">We use cookies to enhance your browsing experience and analyze site traffic.</p>
          <div class="lg-info-grid">
            <div class="lg-info-item">
              <div class="lg-hi-icon"><Activity size={20} /></div>
              <div class="lg-info-content">
                <h4>Performance</h4>
                <p>Tracking site speed and usage metrics</p>
              </div>
            </div>
            <div class="lg-info-item">
              <div class="lg-hi-icon"><Globe size={20} /></div>
              <div class="lg-info-content">
                <h4>Global Settings</h4>
                <p>Remembering your language and preferences</p>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- DMCA Policy -->
      <article class="lg-card" id="dmca-policy">
        <div class="lg-card-header">
          <div class="lg-card-icon">
            <Scale size={28} />
          </div>
          <div class="lg-card-title">
            <h2>DMCA Policy</h2>
            <span class="lg-last-updated">Copyright Information</span>
          </div>
        </div>
        <div class="lg-card-body">
          <p class="lg-intro-text">Respecting intellectual property rights is a core value of LiteScaler.</p>
          <div class="lg-policy-section">
            <h3>Notice Procedure</h3>
            <p>Submit claims of infringement to <strong>legal@litescaler.com</strong> with all necessary evidence and identification.</p>
          </div>
        </div>
      </article>

      <!-- Disclaimer -->
      <article class="lg-card" id="disclaimer">
        <div class="lg-card-header">
          <div class="lg-card-icon">
            <Shield size={28} />
          </div>
          <div class="lg-card-title">
            <h2>Disclaimer</h2>
            <span class="lg-last-updated">Legal Notice</span>
          </div>
        </div>
        <div class="lg-card-body">
          <div class="lg-policy-section">
            <p>Information provided is on an "as-is" basis. While we strive for accuracy, LiteScaler makes no warranties regarding completeness or reliability of the data presented.</p>
          </div>
        </div>
      </article>

      <!-- Contact Us -->
      <article class="lg-card" id="contact-us">
        <div class="lg-card-header">
          <div class="lg-card-icon">
            <Mail size={28} />
          </div>
          <div class="lg-card-title">
            <h2>Contact Us</h2>
            <span class="lg-last-updated">Legal Support</span>
          </div>
        </div>
        <div class="lg-card-body">
          <p class="lg-intro-text">For legal inquiries, contact our team directly.</p>
          <div class="lg-contact-options">
            <a href="mailto:legal@litescaler.com" class="lg-contact-option">
              <div class="lg-hi-icon"><Mail size={20} /></div>
              <div>
                <span class="lg-contact-info-label">Email Support</span>
                <span class="lg-contact-info-value">legal@litescaler.com</span>
              </div>
            </a>
            <a href="tel:+918800126404" class="lg-contact-option">
              <div class="lg-hi-icon"><Activity size={20} /></div>
              <div>
                <span class="lg-contact-info-label">Direct Line</span>
                <span class="lg-contact-info-value">+91 88001 26404</span>
              </div>
            </a>
          </div>
        </div>
      </article>

    </main>
  </div>

  <script>
    function initLegalNav() {
      const sections = document.querySelectorAll('.lg-card');
      const navLinks = document.querySelectorAll('.lg-sidebar-link');

      if (!sections.length || !navLinks.length) return;

      const observerOptions = {
        root: null,
        rootMargin: '-100px 0px -70% 0px',
        threshold: 0
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            navLinks.forEach(link => {
              link.classList.toggle('active', link.getAttribute('href') === `#${id}`);
            });
          }
        });
      }, observerOptions);

      sections.forEach(section => observer.observe(section));
    }

    // Initialize on load
    initLegalNav();
    // Re-initialize for view transitions
    document.addEventListener('astro:page-load', initLegalNav);
  </script>

</BaseLayout>