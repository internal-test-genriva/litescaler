---
import logo from '../assets/icon.png';

const footerLinks = {
  services: [
    { name: 'Web Hosting', href: '/services' },
    { name: 'Cloud Hosting', href: '/services' },
    { name: 'VPS Hosting', href: '/services' },
    { name: 'Dedicated Servers', href: '/services' },
  ],
  company: [
    { name: 'About Us', href: '/about' },
    { name: 'Careers', href: '/careers' },
    { name: 'Blog', href: '/blog' },
    { name: 'Contact', href: '/contact' },
  ],
  support: [
    { name: 'Help Center', href: '/help' },
    { name: 'Status Page', href: '/status' },
    { name: 'API Docs', href: '/docs' },
    { name: 'Community', href: '/community' },
  ],
  legal: [
    { name: 'Privacy Policy', href: '/privacy' },
    { name: 'Terms of Service', href: '/terms' },
    { name: 'SLA', href: '/sla' },
    { name: 'GDPR', href: '/gdpr' },
  ],
};
---

<footer class="site-footer">
  <!-- Decorative Pre-Footer CTA -->
  <div class="pre-footer-cta">
    <div class="container sf-cta-container">
      <div class="cta-inner">
        <div class="cta-text">
          <h2>Ready to experience <br/> the <span class="accent">next generation</span> of hosting?</h2>
          <p>Join over 10,000+ developers scaling with LiteScaler.</p>
        </div>
        <div class="cta-actions">
          <a href="/services" class="btn-primary-footer">Get Started Now</a>
          <a href="/contact" class="btn-secondary-footer">Talk to an Expert</a>
        </div>
      </div>
    </div>
  </div>

  <div class="container footer-main-content">
    <div class="footer-grid">
      <!-- Brand & Newsletter -->
      <div class="brand-column col-span-2">
        <a href="/" class="footer-logo">
          <img src={logo.src} alt="LiteScaler logo" class="footer-logo-img" />
          <span class="logo-text">LiteScaler</span>
        </a>
        <p class="brand-desc">
          Engineering the world's fastest hosting infrastructure. 
          Power your presence with NVMe-powered edge nodes and global redundancy.
        </p>
        
        <div class="newsletter-wrap">
          <h4>Stay in the loop</h4>
          <p>Get the latest updates and developer resources.</p>
          <form class="newsletter-form">
            <input type="email" placeholder="Enter your email" required />
            <button type="submit">Subscribe</button>
          </form>
        </div>

        <div class="social-links">
          <a href="#" aria-label="Twitter" class="social-icon">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
          </a>
          <a href="#" aria-label="LinkedIn" class="social-icon">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z"/></svg>
          </a>
          <a href="#" aria-label="Instagram" class="social-icon">
  <svg viewBox="0 0 24 24" fill="currentColor">
    <path d="M7.75 2C4.574 2 2 4.574 2 7.75v8.5C2 19.426 4.574 22 7.75 22h8.5C19.426 22 22 19.426 22 16.25v-8.5C22 4.574 19.426 2 16.25 2h-8.5zm0 2h8.5C18.321 4 20 5.679 20 7.75v8.5c0 2.071-1.679 3.75-3.75 3.75h-8.5C5.679 20 4 18.321 4 16.25v-8.5C4 5.679 5.679 4 7.75 4zm8.75 1.5a1.25 1.25 0 1 0 0 2.5 1.25 1.25 0 0 0 0-2.5zM12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6z"/>
  </svg>
</a>
        </div>
      </div>

      <!-- Links Groups -->
       <div class="links-column">
        <h3 class="footer-title">Services</h3>
        <ul class="footer-list">
          {footerLinks.services.map((link) => (
            <li><a href={link.href} class="footer-link"><span>{link.name}</span></a></li>
          ))}
        </ul>
      </div>

      <div class="links-column">
        <h3 class="footer-title">Company</h3>
        <ul class="footer-list">
          {footerLinks.company.map((link) => (
            <li><a href={link.href} class="footer-link"><span>{link.name}</span></a></li>
          ))}
        </ul>
      </div>

      <div class="links-column">
        <h3 class="footer-title">Support</h3>
        <ul class="footer-list">
          {footerLinks.support.map((link) => (
            <li><a href={link.href} class="footer-link"><span>{link.name}</span></a></li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div class="bottom-left">
        <p>© 2026 LiteScaler. All rights reserved.</p>
        <div class="bottom-links">
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="/legal">SLA</a>
        </div>
      </div>
      <div class="bottom-right">
        <div class="bottom-tag">
          <span>Built for builders</span>
          <span class="heart">❤️</span>
          <span>by LiteScaler</span>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background-color: #030712;
    padding: 80px 24px 40px;
    border-top: 1px solid rgba(15, 23, 42, 0.05);
    overflow: hidden;
    font-family: 'Poppins', sans-serif;
    width: 100%;
  }

  .site-footer .container {
    max-width: 1280px;
    margin: 0 auto !important;
    position: relative;
    z-index: 10;
    width: 100%;
  }

  /* PRE-FOOTER CTA */
  .pre-footer-cta {
    padding: 0 0 80px 0;
    border-bottom: 1px solid rgba(15, 23, 42, 0.05);
    margin-bottom: 80px;
    width: 100%;
  }

  .cta-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
    width: 100%;
  }

  .cta-text {
    max-width: 600px;
  }

  .cta-text h2 {
    font-size: 42px;
    font-weight: 600;
    color: #ffffffff;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }

  .cta-text .accent {
    color: #2380F4;
  }

  .cta-text p {
    font-size: 18px;
    color: #64748b;
    margin: 0;
  }

  .cta-actions {
    display: flex;
    gap: 16px;
    flex-shrink: 0;
  }

  .btn-primary-footer {
    background: #2380F4;
    color: #ffffff;
    padding: 16px 32px;
    border-radius: 12px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 10px 20px rgba(35, 128, 244, 0.2);
    white-space: nowrap;
  }

  .btn-primary-footer:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 30px rgba(35, 128, 244, 0.3);
  }

  .btn-secondary-footer {
    background: #f8fafc;
    color: #0f172a;
    padding: 16px 32px;
    border-radius: 12px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    border: 1px solid rgba(15, 23, 42, 0.1);
    white-space: nowrap;
  }

  .btn-secondary-footer:hover {
    background: #f1f5f9;
  }

  /* FOOTER MAIN CONTENT */
  .footer-main-content {
    padding-bottom: 60px;
    width: 100%;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 60px;
    margin-bottom: 80px;
    width: 100%;
  }

  .brand-column {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 100%;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .footer-logo-img {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  .logo-text {
    font-size: 22px;
    font-weight: 500;
    color: #ffffffff;
    letter-spacing: -0.01em;
  }

  .brand-desc {
    font-size: 15px;
    line-height: 1.6;
    color: #64748b;
    margin: 0;
  }

  /* NEWSLETTER */
  .newsletter-wrap {
    margin-top: 10px;
  }

  .newsletter-wrap h4 {
    font-size: 14px;
    font-weight: 700;
    color: #ffffffff;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .newsletter-wrap p {
    font-size: 14px;
    color: #64748b;
    margin-bottom: 16px;
  }

  .newsletter-form {
    display: flex;
    gap: 8px;
    max-width: 400px;
  }

  .newsletter-form input {
    flex: 1;
    background: #f8fafc;
    border: 1px solid rgba(15, 23, 42, 0.1);
    padding: 14px 18px;
    border-radius: 10px;
    font-size: 14px;
    color: #0f172a;
    outline: none;
    transition: all 0.2s;
  }

  .newsletter-form input:focus {
    border-color: #2380F4;
    background: #ffffff;
    box-shadow: 0 0 0 4px rgba(35, 128, 244, 0.05);
  }

  .newsletter-form button {
    background: #0f172a;
    color: #ffffff;
    padding: 14px 24px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 14px;
    border: none;
    cursor: pointer;
    transition: transform 0.2s, opacity 0.2s;
  }

  .newsletter-form button:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .social-links {
    display: flex;
    gap: 12px;
    margin-top: 8px;
  }

  .social-icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: #f8fafc;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
    border: 1px solid rgba(15, 23, 42, 0.05);
  }

  .social-icon:hover {
    color: #2380F4;
    background: rgba(35, 128, 244, 0.1);
    border-color: rgba(35, 128, 244, 0.2);
    transform: translateY(-2px);
  }

  .social-icon svg {
    width: 18px;
    height: 18px;
  }

  /* LINKS */
  .footer-title {
    font-size: 14px;
    font-weight: 700;
    color: #ffffffff;
    margin-bottom: 24px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .footer-link {
    text-decoration: none;
    color: #64748b;
    font-size: 14px;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
  }

  .footer-link:hover {
    color: #2380F4;
    transform: translateX(4px);
  }

  /* BOTTOM BAR */
  .footer-bottom {
    padding-top: 40px;
    border-top: 1px solid rgba(15, 23, 42, 0.05);
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .bottom-left {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .bottom-left p {
    font-size: 13px;
    color: #94a3b8;
    margin: 0;
  }

  .bottom-links {
    display: flex;
    gap: 20px;
  }

  .bottom-links a {
    text-decoration: none;
    color: #94a3b8;
    font-size: 13px;
    transition: color 0.2s;
  }

  .bottom-links a:hover {
    color: #2380F4;
  }

  .bottom-tag {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: #94a3b8;
    font-weight: 500;
  }

  .heart {
    color: #ef4444;
    animation: heartbeat 1.5s ease infinite;
    display: inline-block;
  }

  @keyframes heartbeat {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.2); }
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 60px;
    }
    .brand-column {
      grid-column: span 2;
    }
    .cta-inner {
      flex-direction: column;
      text-align: center;
      gap: 32px;
    }
    .cta-text h2 {
      font-size: 36px;
    }
  }

  @media (max-width: 768px) {
    .footer-bottom {
      flex-direction: column;
      gap: 24px;
      text-align: center;
    }
    .bottom-left {
      flex-direction: column;
      gap: 16px;
    }
    .bottom-links {
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .brand-column {
      grid-column: span 1;
    }
    .cta-actions {
      flex-direction: column;
      width: 100%;
    }
    .btn-primary-footer, .btn-secondary-footer {
      text-align: center;
      width: 100%;
    }
    .newsletter-form {
      flex-direction: column;
    }
    .newsletter-form button {
      width: 100%;
    }
  }
</style>