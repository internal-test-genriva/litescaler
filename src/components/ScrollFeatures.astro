---
import { Zap, Shield, Cloud, Server, Mail, PenLine, Cpu, Lock, ShieldCheck } from 'lucide-react';
import img1 from '../assets/img1.png';
import img2 from '../assets/img2.png';
---

<section class="scroll-features-section" id="scroll-features">
  <div class="sf-container">
    
    <div class="sf-header">
       <h2 class="sf-main-title">Everything you need <br/> to build and run your website</h2>
       <p class="sf-subtitle">From hosting and domains to business email and AI tools — all in one place.</p>
    </div>

    <!-- The tall scrolling track that allows native CSS sticky to work over distance -->
    <div class="sf-timeline-track" id="sf-timeline-track">
       <div class="sf-sticky-wrapper" id="sf-sticky-wrapper">
          
          <div class="sf-cards-stack">
          
          <!-- CARD 0: Cloud Hosting -->
          <div class="sf-card card-0" id="card-0">
             <div class="sf-card-inner">
                <div class="sf-content-side">
                   <span class="sf-badge">Cloud Hosting</span>
                   <h3 class="sf-title">High-performance cloud hosting</h3>
                   <p class="sf-desc">Feature-rich cloud hosting with top-tier server specs and high uptime for consistent performance.</p>
                   <a href="#" class="sf-btn">View Plans and Pricing</a>
                </div>
                
                <div class="sf-vertical-divider">
                   <div class="sf-div-icon"><Zap size={18} strokeWidth={2} /></div>
                   <div class="sf-div-icon"><Shield size={18} strokeWidth={2} /></div>
                   <div class="sf-div-icon"><Cloud size={18} strokeWidth={2} /></div>
                   <div class="sf-div-icon"><Server size={18} strokeWidth={2} /></div>
                </div>

                <div class="sf-visual-side">
                   <div class="cloud-visual-bg">
                      <div class="cv-search-bar">
                         <span class="cv-icon"><Lock size={12} /></span>
                         <span class="cv-url">www.website.com</span>
                         <span class="cv-icon">🔍</span>
                      </div>
                      <h4 class="cv-heading">Grow Your Brand in the Cloud</h4>
                      
                      <div class="cv-elements-grid">
                         <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=400&h=300&fit=crop" class="cv-img-woman" alt="Dashboard" />
                         
                         <div class="cv-chart-box">
                            <svg viewBox="0 0 100 50" class="cv-chart-line" preserveAspectRatio="none">
                               <path d="M0,45 L15,35 L30,40 L45,20 L60,30 L75,10 L100,5" stroke="#3b82f6" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                         </div>
                         
                         <div class="cv-speed-box glass-effect">
                            <span class="cv-speed-text">Page speed</span>
                            <div class="cv-gauge">
                               <div class="cv-gauge-inner"></div>
                            </div>
                         </div>
                      </div>
                   </div>
                </div>
             </div>
          </div>

          <!-- CARD 1: Business Email -->
          <div class="sf-card card-1" id="card-1">
             <div class="sf-card-inner reversed">
                
                <div class="sf-visual-side">
                   <div class="email-visual-wrapper">
                      <!-- Blue Sidebar -->
                       <div class="ev-sidebar">
                          <div class="ev-mail-icon"><Mail size={22} color="#fff" strokeWidth={2} /></div>
                          <div class="ev-nav-squares">
                             <div class="ev-sq active"></div>
                             <div class="ev-sq"></div>
                             <div class="ev-sq"></div>
                             <div class="ev-sq"></div>
                          </div>
                          <div class="ev-sidebar-bottom">
                             <div class="ev-sq-small"></div>
                          </div>
                       </div>
                      
                      <!-- Main content -->
                      <div class="ev-main">
                         <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=600&h=400&fit=crop" class="ev-main-img" alt="Professional" />
                         
                         <!-- Floating Window -->
                         <div class="ev-float-card glass-effect">
                            <div class="ev-email-row">To: <span class="ev-blue-text">offer@yourcompany.com</span></div>
                            <div class="ev-email-row">Subject: <b>Creative Pots on Sale!</b></div>
                            <img src="https://images.unsplash.com/photo-1610701596007-11502861dcfa?w=300&h=200&fit=crop" class="ev-email-img" alt="Vases" />
                         </div>
                      </div>
                   </div>
                </div>

                <div class="sf-content-side">
                   <span class="sf-badge">Business Email</span>
                   <h3 class="sf-title">Professional email for your business</h3>
                   <p class="sf-desc">Get secure, professional email accounts with your own domain — no website hosting required.</p>
                   <a href="#" class="sf-btn">Get Started</a>
                </div>

             </div>
          </div>

          <!-- CARD 2: App Installer -->
          <div class="sf-card card-2" id="card-2">
             <div class="sf-card-inner">
                <div class="sf-content-side">
                   <span class="sf-badge">App Installer</span>
                   <h3 class="sf-title">One-click app installation</h3>
                   <p class="sf-desc">Install over 400 applications including WordPress, Joomla, and Magento instantly with a single click.</p>
                   <a href="#" class="sf-btn">Explore Apps</a>
                </div>
                
                <div class="sf-visual-side apps-visual" style="padding: 0; position: relative;">
                   <img src={img2.src} alt="App Installer" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;" />
                </div>
             </div>
          </div>

          <!-- CARD 3: Analytics -->
          <div class="sf-card card-3" id="card-3">
             <div class="sf-card-inner reversed">
                <div class="sf-visual-side monitor-visual">
                   <div class="mv-dashboard shadow-glass">
                      <div class="mv-dash-top"><Cpu size={16} /> Resource Usage</div>
                      <div class="mv-bars">
                         <div class="mv-bar-row">
                            <span>CPU (45%)</span>
                            <div class="mv-bar-bg"><div class="mv-bar-fill" style="width: 45%; background: #3b82f6;"></div></div>
                         </div>
                         <div class="mv-bar-row">
                            <span>RAM (72%)</span>
                            <div class="mv-bar-bg"><div class="mv-bar-fill" style="width: 72%; background: #8b5cf6;"></div></div>
                         </div>
                         <div class="mv-bar-row">
                            <span>Disk (28%)</span>
                            <div class="mv-bar-bg"><div class="mv-bar-fill" style="width: 28%; background: #10b981;"></div></div>
                         </div>
                      </div>
                   </div>
                </div>

                <div class="sf-content-side">
                   <span class="sf-badge">Analytics</span>
                   <h3 class="sf-title">Real-time resource monitoring</h3>
                   <p class="sf-desc">Keep track of your server's performance, CPU, RAM, and bandwidth usage with our intuitive dashboard.</p>
                   <a href="#" class="sf-btn">View Dashboard</a>
                </div>
             </div>
          </div>

          <!-- CARD 4: DDoS -->
          <div class="sf-card card-4" id="card-4">
             <div class="sf-card-inner">
                <div class="sf-content-side">
                   <span class="sf-badge">Security</span>
                   <h3 class="sf-title">Advanced DDoS Protection</h3>
                   <p class="sf-desc">We automatically mitigate malicious traffic and block volumetric attacks to keep your website online 24/7.</p>
                   <a href="#" class="sf-btn">Learn More</a>
                </div>
                
                <div class="sf-visual-side ddos-visual" style="padding: 0; position: relative;">
                   <img src={img1.src} alt="DDoS Protection" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;" />
                </div>
             </div>
          </div>

          </div>
       </div>
    </div>
  </div>
</section>

<style>
/* Base Layout */
.scroll-features-section {
  padding: 100px 24px;
  background-color: #fafafa;
  font-family: poppins, sans-serif;
  position: relative;
}

.sf-container {
  max-width: 1200px;
  margin: 0 auto;
}

/* Header */
.sf-header {
  text-align: center;
  margin-bottom: 140px;
}
.sf-main-title {
  font-size: 44px;
  font-weight: 500;
  color: #0f172a;
  letter-spacing: -0.03em;
  margin: 0 0 16px 0;
  line-height: 1.1;
}
.sf-subtitle {
  font-size: 18px;
  color: #475569;
  margin: 0;
}

/* -------------------------------- */
/* Sticky Wrapper & Stack Logic     */
/* -------------------------------- */
.sf-timeline-track {
  position: relative;
  width: 100%;
}

.sf-sticky-wrapper {
  position: relative;
  width: 100%;
  height: 600px;
}
@media (max-width: 900px) {
  .sf-sticky-wrapper { position: relative; top: auto; height: auto; overflow: visible; padding-top: 20px;}
}

.sf-cards-stack {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 32px !important;
}
@media (max-width: 900px) {
  .sf-cards-stack { display: flex; flex-direction: column; gap: 40px; }
}

/* Individual Card Setup */
.sf-card {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
   background: #ffffff;
   border-radius: 32px !important;
   border: 1px solid rgba(15,23,42,0.08); /* Slightly more visible border */
   box-shadow: 0 4px 24px rgba(0,0,0,0.04); /* Subtle shadow for depth */
   transform-origin: top center;
   display: flex;
   overflow: hidden;
   z-index: 1;
}
@media (max-width: 900px) {
  .sf-card { position: relative; height: auto; min-height: 500px; display: block;}
}

/* Hard Z-Indexes dictating physical layers correctly */
.card-0 { z-index: 10; }
.card-1 { z-index: 20; }
.card-2 { z-index: 30; }
.card-3 { z-index: 40; }
.card-4 { z-index: 50; }

.sf-card-inner {
  display: flex;
  height: 100%; width: 100%;
}
.sf-card-inner.reversed {
  flex-direction: row-reverse;
}
@media (max-width: 900px) {
  .sf-card-inner, .sf-card-inner.reversed { flex-direction: column; }
}

/* -------------------------------- */
/* Content Details (Text)           */
/* -------------------------------- */
.sf-content-side {
  flex: 1;
  padding: 80px 60px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
}
@media (max-width: 900px) {
  .sf-content-side { padding: 40px 24px; order: 2; }
}

.sf-badge {
  background: #f1f5f9;
  color: #64748b;
  padding: 8px 16px;
  font-size: 13px;
  font-weight: 500;
  border-radius: 20px;
  margin-bottom: 24px;
}
.sf-title {
  font-size: 36px;
  font-weight: 600;
  color: #0f172a;
  letter-spacing: -0.02em;
  line-height: 1.2;
  margin: 0 0 16px 0;
}
.sf-desc {
  font-size: 16px;
  color: #475569;
  line-height: 1.6;
  margin: 0 0 32px 0;
}
.sf-btn {
  background: #2563eb;
  color: #ffffff;
  padding: 14px 28px;
  border-radius: 12px !important;
  font-size: 15px;
  font-weight: 500;
  text-decoration: none;
  transition: all 0.2s ease;
}
.sf-btn:hover { background: #1d4ed8; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(37,99,235,0.25);}


/* -------------------------------- */
/* Visual Details (Mockups)         */
/* -------------------------------- */
.sf-visual-side {
  flex: 1.2;
  position: relative;
  display: flex;
  background: #ffffff; 
}
@media (max-width: 900px) {
  .sf-visual-side { height: 350px; flex: none; order: 1; }
}

/* Divder Icons (Card 1) */
.sf-vertical-divider {
  width: 50px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20px;
  border-left: 1px solid #f1f5f9;
}
@media (max-width: 900px) { .sf-vertical-divider { display: none; } }
.sf-div-icon {
  width: 40px; height: 40px;
  border-radius: 50%;
  border: 1px solid #e2e8f0;
  display: flex; align-items: center; justify-content: center;
  color: #64748b;
  background: #ffffff;
}

/* --- Card 1 Cloud BG --- */
.cloud-visual-bg {
  flex: 1;
  background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
  border-top-right-radius: 32px !important;
  border-bottom-right-radius: 32px !important;
  padding: 40px;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}
@media (max-width: 900px) {
  .cloud-visual-bg { border-radius: 32px 32px 0 0; padding: 20px; }
}
/* Glassmorphism Classes */
.glass-effect {
  background: rgba(255, 255, 255, 0.85); 
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.6);
}

.cv-search-bar {
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(8px);
  border-radius: 12px;
  padding: 12px 16px;
  display: flex; align-items: center; gap: 12px;
  margin-bottom: 24px;
  box-shadow: 0 10px 20px rgba(0,0,0,0.1);
}
.cv-icon { color: #94a3b8; font-size: 14px; }
.cv-url { color: #0f172a; font-size: 14px; font-weight: 500; flex: 1; text-align: center; }
.cv-heading { color: #ffffff; font-size: 26px; font-weight: 600; margin: 0 0 24px 0; text-align: center;}
.cv-elements-grid { display: flex; gap: 16px; position: relative; flex: 1;}
.cv-img-woman { width: 45%; border-radius: 16px; object-fit: cover; height: 180px; box-shadow: 0 15px 30px rgba(0,0,0,0.15); }
.cv-chart-box { 
  width: 50%; background: #ffffff; border-radius: 16px; height: 180px; padding: 24px; box-shadow: 0 15px 30px rgba(0,0,0,0.15);
  display: flex; align-items: center; justify-content: center;
}
.cv-chart-line { width: 100%; height: 100%; }
.cv-speed-box {
  position: absolute; bottom: 0px; right: 20px;
  padding: 16px 24px; border-radius: 16px; box-shadow: 0 20px 40px rgba(0,0,0,0.2);
  text-align: center;
}
.cv-speed-text { font-size: 12px; font-weight: 600; color: #475569; display: block; margin-bottom: 12px; }
.cv-gauge { width: 80px; height: 40px; background: rgba(0,0,0,0.05); border-top-left-radius: 50px; border-top-right-radius: 50px; position: relative; overflow: hidden; margin: 0 auto; }
.cv-gauge-inner { position: absolute; bottom: 0; left: 0; width: 100%; height: 100%; background: #10b981; transform-origin: bottom center; transform: rotate(50deg); border-top-left-radius: 50px; border-top-right-radius: 50px;}

/* --- Card 2 Email Visual --- */
.email-visual-wrapper {
  flex: 1; display: flex;
  background: #ffffff;
  border-top-left-radius: 32px !important;
  border-bottom-left-radius: 32px !important;
  overflow: hidden;
}
@media (max-width: 900px) {
  .email-visual-wrapper { border-radius: 32px 32px 0 0; }
}
.ev-sidebar {
  width: 70px; background: #2563eb; display: flex; flex-direction: column; align-items: center; padding: 24px 0; gap: 40px;
}
.ev-nav-squares { display: flex; flex-direction: column; gap: 20px; }
.ev-sq { width: 22px; height: 22px; background: rgba(255,255,255,0.2); border-radius: 6px; transition: all 0.3s ease;}
.ev-sq.active { background: #fff; }
.ev-sq:hover { background: rgba(255,255,255,0.4); }
.ev-sidebar-bottom { margin-top: auto; padding-bottom: 20px; }
.ev-sq-small { width: 16px; height: 16px; background: rgba(255,255,255,0.3); border-radius: 4px; }

.ev-main { flex: 1; position: relative; padding: 20px; background: #ffffff; display: flex; align-items: center; justify-content: center; }
.ev-main-img { width: 100%; height: 100%; border-radius: 20px; object-fit: cover; box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
.ev-float-card {
  position: absolute; bottom: 30px; right: 30px;
  padding: 16px; border-radius: 16px; box-shadow: 0 20px 40px rgba(0,0,0,0.15); width: 220px;
  z-index: 10;
}
.ev-email-row { font-size: 11px; color: #475569; margin-bottom: 6px; }
.ev-blue-text { color: #2563eb; font-weight: 600; }
.ev-email-img { width: 100%; height: 70px; border-radius: 8px; object-fit: cover; margin-top: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.05);}


/* --- Cards 3, 4, 5 Simplified Mockups --- */
.apps-visual, .monitor-visual, .ddos-visual {
  flex: 1; background: #f8fafc; display: flex; align-items: center; justify-content: center; position: relative;
}
.av-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-right: 40px;}
.shadow-box { width: 80px; height: 80px; background: white; border-radius: 20px; display: flex; align-items: center; justify-content: center; box-shadow: 0 10px 30px rgba(0,0,0,0.06); }
.av-letter { font-size: 36px; font-weight: 700; }
.shadow-glass { background: rgba(255,255,255,0.9); backdrop-filter: blur(8px); padding: 32px; border-radius: 20px; box-shadow: 0 20px 50px rgba(0,0,0,0.1); text-align: center; border: 1px solid rgba(255,255,255,0.5);}
.av-install-title { margin: 0 0 10px 0; font-size: 20px; font-weight: 600;}
.av-install-desc { font-size: 13px; color: #64748b; margin: 0 0 20px 0; max-width: 180px;}
.av-install-btn { background: #10b981; color: white; border: none; padding: 10px 20px; border-radius: 8px; font-size: 14px; cursor: pointer; font-weight: 500;}

.mv-dashboard { width: 340px; }
.mv-dash-top { font-size: 15px; font-weight: 600; display: flex; align-items: center; gap: 10px; margin-bottom: 24px; border-bottom: 1px solid #f1f5f9; padding-bottom: 16px;}
.mv-bars { display: flex; flex-direction: column; gap: 20px; }
.mv-bar-row span { font-size: 13px; color: #475569; display: block; margin-bottom: 8px; font-weight: 500; }
.mv-bar-bg { width: 100%; height: 10px; background: #e2e8f0; border-radius: 5px; }
.mv-bar-fill { height: 100%; border-radius: 5px; }

.dv-shield-container { position: relative; width: 180px; height: 180px; display: flex; align-items: center; justify-content: center; background: white; border-radius: 50%; box-shadow: 0 20px 50px rgba(16,185,129,0.2);}
.dv-ping { position: absolute; width: 100%; height: 100%; border-radius: 50%; border: 3px solid #10b981; opacity: 0; animation: ping 2.5s infinite cubic-bezier(0, 0, 0.2, 1); }
.dv-ping.p2 { animation-delay: 0.8s; }
.dv-ping.p3 { animation-delay: 1.6s; }
@keyframes ping {
  75%, 100% { transform: scale(1.8); opacity: 0; }
  0% { transform: scale(1); opacity: 0.8; }
}
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  document.addEventListener('DOMContentLoaded', () => {
    gsap.registerPlugin(ScrollTrigger);

    const isMobile = window.innerWidth <= 900;
    if (isMobile) return;

    const cards = gsap.utils.toArray('.sf-card');
    const triggerSection = document.getElementById('scroll-features'); 
    const stackWrapper = document.getElementById('sf-sticky-wrapper');
    const track = document.getElementById('sf-timeline-track');
    
    // Config: How much scroll distance per card
    const triggerDistancePerCard = window.innerHeight * 0.8; 
    const totalDistance = triggerDistancePerCard * (cards.length - 1);

    if (cards.length > 0 && triggerSection && stackWrapper && track) {
      
      // Clear manual explicit height mutations to ensure GSAP has a clean slate
      gsap.set(track, { clearProps: "height" });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: triggerSection,
          start: 'top 120px', // Adjusted for site header
          end: `+=${totalDistance}`,
          scrub: 0.8, // Slightly smoother scrub
          pin: true, 
          anticipatePin: 1
        }
      });

      // Z-Index hierarchy
      cards.forEach((card, i) => {
        gsap.set(card, { zIndex: (i + 1) * 10 });
      });

      // Set explicit initial states
      cards.forEach((card, i) => {
        gsap.set(card, { 
          y: i === 0 ? "0%" : "120%", // Start slightly lower for cleaner entry
          scale: 1,
          opacity: 1 
        });
      });

      // Strict deterministic mathematical timeline mapping
      cards.forEach((card, i) => {
        if (i === 0) return; 

        tl.fromTo(card, 
          {
            y: "120%",
            opacity: 0.8 // Fade in slightly
          },
          {
            y: "0%", 
            opacity: 1,
            ease: 'none',
            duration: 1 
          }, i - 1);

        // Previous cards shrink and fade backwards safely
        cards.slice(0, i).forEach((prevCard, prevIndex) => {
           const currentDepth = (i - 1) - prevIndex; 
           const nextDepth = i - prevIndex; 
           
           tl.fromTo(prevCard, 
             {
                scale: 1 - (currentDepth * 0.08), // More aggressive scale
                y: `-${currentDepth * 15}px`,
                opacity: 1 - (currentDepth * 0.2) // Increased fade
             },
             {
                scale: 1 - (nextDepth * 0.08), 
                y: `-${nextDepth * 15}px`, 
                opacity: 1 - (nextDepth * 0.2), 
                ease: 'none',
                duration: 1
             }, i - 1); 
        });
      });
    }
  });
</script>
