---
import { Check, ChevronDown } from 'lucide-react';
import freeDomainSvg from '../assets/free-domain.svg';

const plans = [
  {
    name: "The TEJAS Plan",
    version: "(WordPress Starter)",
    price: "489",
    description: "Perfect for bloggers and small WordPress sites needing a fast, secure managed environment.",
    originalPrice: "879",
    discount: "50% OFF",
    features: [
      "1 Managed WordPress Website + Staging",
      "5 GB NVMe Gen4 Storage",
      "1 vCPU Core dedicated allocation",
      "1 GB RAM dedicated allocation",
      "One-Click WordPress Install",
      "Automatic WordPress Updates",
      "WordPress Auto-Backup (Daily)",
      "Free SSL Certificate",
      "LiteSpeed + LSCache Plugin",
      "WordPress Malware Scanning",
      "WP-CLI & SSH Access",
      "Multi-PHP Version Control",
      "Unlimited Bandwidth",
      "One-Click Cloudflare Integration",
      "Professional Email Accounts",
      "Real-Time Traffic Dashboards",
      "One-Click \"White-Glove\" Site Migration",
      "WordPress-Optimised Firewall (WAF)",
      "24/7 WordPress Expert Support"
    ],
    buttonText: "Order Now",
    highlight: false,
  },
  {
    name: "The RAFALE Plan",
    version: "(WordPress Business)",
    price: "879",
    description: "Our most popular choice for growing WordPress businesses and multi-site management.",
    originalPrice: "3499",
    discount: "50% OFF",
    features: [
      "10 Managed WordPress Websites + Staging",
      "20 GB NVMe Gen4 Storage",
      "2 vCPU Core dedicated allocation",
      "2 GB RAM dedicated allocation",
      "One-Click WordPress Install",
      "Automatic WordPress Updates",
      "WordPress Auto-Backup (Daily + On-Demand)",
      "Free SSL Certificate",
      "LiteSpeed Enterprise + LSCache Plugin",
      "Advanced WordPress Malware Scanning",
      "WP-CLI & SSH Access",
      "Multi-PHP Version Control",
      "Unlimited Bandwidth",
      "One-Click Cloudflare Integration",
      "Professional Unlimited Email Accounts",
      "Real-Time Traffic Dashboards",
      "One-Click \"White-Glove\" Site Migration",
      "WordPress-Optimised WAF + DDoS Protection",
      "24/7 Priority WordPress Expert Support"
    ],
    buttonText: "Order Now",
    highlight: true,
    badge: "MOST POPULAR",
  },
  {
    name: "The AMCA Plan",
    version: "(WordPress Enterprise)",
    price: "5499",
    description: "Enterprise-grade managed WordPress for high-traffic sites and demanding web applications.",
    originalPrice: "3999",
    discount: "50% OFF",
    features: [
      "Unlimited Managed WordPress Websites",
      "40 GB NVMe Gen4 Storage",
      "4 vCPU Core dedicated allocation",
      "4 GB RAM dedicated allocation",
      "One-Click WordPress Install",
      "Automatic WordPress Updates",
      "WordPress Auto-Backup (Hourly + Off-Site)",
      "Free Wildcard SSL Certificate",
      "LiteSpeed Enterprise + LSCache Plugin",
      "Real-Time WordPress Malware Removal",
      "WP-CLI & SSH Access",
      "Multi-PHP Version Control",
      "Unlimited Bandwidth",
      "One-Click Cloudflare Enterprise Integration",
      "Professional Unlimited Email Accounts",
      "Advanced Traffic & Analytics Dashboards",
      "One-Click \"White-Glove\" Site Migration",
      "WordPress-Optimised WAF + DDoS + Bot Protection",
      "Dedicated 24/7 WordPress Expert Support"
    ],
    buttonText: "Order Now",
    highlight: false,
  }
];
---

<section class="pricing-premium-section" id="pricing">
  <div class="pricing-container">
    <div class="pricing-header">
      <h2 class="pricing-title">Choose your <span class="accent-text">WordPress hosting plan</span></h2>
      <p class="pricing-subtitle">
        Fully managed WordPress hosting engineered for speed and security. Whether you're running a personal blog or a high-traffic business site, our LiteSpeed-powered infrastructure keeps WordPress flying.
      </p>

      <div class="trust-indicators">
        <span class="indicator"><Check size={16} color="#2380F4" /> Monthly or long-term</span>
        <span class="indicator"><Check size={16} color="#2380F4" /> 24/7 WordPress support</span>
        <span class="indicator"><Check size={16} color="#2380F4" /> 99.9% uptime</span>
      </div>
    </div>

    <div class="pricing-grid">
      {plans.map((plan, index) => (
          <div class={`pricing-card ${plan.highlight ? 'highlight-card' : ''}`} data-index={index}>
            {plan.badge && <div class="deal-badge">{plan.badge}</div>}

            {plan.name === "The RAFALE Plan" && (
              <div class="free-domain-indicator">
                <img src={freeDomainSvg.src} alt="Free Domain" class="free-domain-svg" />
              </div>
            )}

            <div class="card-top">
              <h3 class="plan-name">{plan.name}</h3>
              <p class="plan-version">{plan.version}</p>
            </div>

            <div class="price-container">
              <div class="discount-row">
                <span class="discount-pill">{plan.discount}</span>
                <span class="old-price">₹{plan.originalPrice}</span>
              </div>
              <div class="current-price">
                <span class="currency">₹</span>
                <span class="price-value">{plan.price}</span>
                <span class="period">/mo</span>
              </div>
              {plan.name === "The RAFALE Plan" && <div class="limited-deal-text">Limited time deal</div>}
            </div>

            <p class="plan-description">{plan.description}</p>

            <button class={`cta-btn ${plan.highlight ? 'primary-btn' : 'secondary-btn'}`}>
              {plan.buttonText}
            </button>

            <div class="expand-wrapper collapsed js-expand-wrapper">
              <div class="expand-inner">
                <ul class="features-list">
                  {plan.features.map((feature) => (
                    <li class="feature-item">
                      <div class="check-icon-wrapper">
                        <Check size={14} color="#2380F4" />
                      </div>
                      <span class="feature-text">{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <button class="global-see-all-btn js-toggle-all-btn">
              <span class="btn-text">See all features</span>
              <ChevronDown size={14} class="arrow-icon" />
            </button>
          </div>
      ))}
    </div>

    <p class="gst-disclaimer">Displayed prices do not include GST (18%).</p>
  </div>
</section>

<style>
  .pricing-premium-section {
    position: relative;
    padding: 140px 0 100px;
    background-color: #ffffff;
    z-index: 1;
  }

  .pricing-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 10;
  }

  .pricing-header {
    text-align: center;
    margin-bottom: 80px;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .pricing-title {
    font-family: 'Poppins', sans-serif;
    font-size: 48px;
    font-weight: 500;
    color: #0f172a;
    margin-bottom: 24px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .accent-text {
    color: #2380F4;
  }

  .pricing-subtitle {
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #475569;
    font-weight: 400;
    margin-bottom: 32px;
  }

  .trust-indicators {
    display: flex;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
    color: #64748b;
    font-size: 14px;
    font-weight: 500;
  }

  .indicator {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    padding: 6px 16px;
    border-radius: 20px;
    border: 1px solid rgba(15, 23, 42, 0.05);
    box-shadow: 0 4px 6px rgba(15, 23, 42, 0.02);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    align-items: start;
    padding-top: 30px; /* space above all cards so the badge doesn't get clipped */
  }

  .free-domain-indicator {
    position: absolute;
    top: -85px;
    right: -140px;
    pointer-events: none;
    z-index: 50;
  }

  .free-domain-svg {
    width: 204px;
    height: auto;
    filter: drop-shadow(0 4px 12px rgba(35, 128, 244, 0.1));
  }

  @media (max-width: 1200px) {
    .free-domain-indicator { right: -100px; }
  }

  @media (max-width: 1080px) {
    .free-domain-indicator { display: none; }
  }

  .pricing-card {
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 32px !important;
    padding: 40px 32px;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pricing-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 30px 60px rgba(35, 128, 244, 0.12);
  }

  .highlight-card {
    border: 2px solid #2380F4;
    box-shadow: 0 30px 60px rgba(35, 128, 244, 0.1);
  }

  .deal-badge {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, #2380F4, #1E6AD1);
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 6px 20px;
    border-radius: 20px;
    white-space: nowrap;
    box-shadow: 0 10px 20px rgba(35, 128, 244, 0.3);
  }

  .card-top {
    text-align: center;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .plan-name {
    font-size: 24px;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 4px 0;
    letter-spacing: -0.01em;
  }

  .plan-version {
    color: #64748b;
    font-size: 13px;
    font-weight: 500;
    margin: 0;
  }

  .price-container {
    text-align: center;
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px dashed rgba(15, 23, 42, 0.1);
  }

  .discount-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .discount-pill {
    background: rgba(16, 185, 129, 0.1);
    color: #059669;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 8px;
  }

  .old-price {
    color: #94a3b8;
    text-decoration: line-through;
    font-size: 14px;
    font-weight: 500;
  }

  .current-price {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 4px;
    color: #0f172a;
  }

  .currency {
    font-size: 24px;
    font-weight: 600;
    margin-top: 8px;
  }

  .price-value {
    font-size: 56px;
    font-weight: 700;
    color: #0f172a;
    line-height: 1;
  }

  .period {
    font-size: 16px;
    color: #64748b;
    margin-left: 2px;
  }

  .limited-deal-text {
    color: #ef4444;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    margin-top: 10px;
    letter-spacing: 0.05em;
  }

  .plan-description {
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: #475569;
    text-align: center;
    margin-bottom: 32px;
    font-weight: 400;
    padding: 0 10px;
  }

  .cta-btn {
    width: 100%;
    padding: 16px;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 24px;
    cursor: pointer;
    border: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .primary-btn {
    background: #2380F4;
    color: #ffffff;
    box-shadow: 0 10px 20px rgba(35, 128, 244, 0.2);
  }

  .pricing-card.highlight-card:hover .primary-btn {
    background: #1E6AD1;
    transform: translateY(-2px);
    box-shadow: 0 15px 30px rgba(35, 128, 244, 0.3);
  }

  .secondary-btn {
    background: #f8fafc;
    color: #0f172a;
    border: 1px solid rgba(15, 23, 42, 0.1);
  }

  .pricing-card:not(.highlight-card):hover .secondary-btn {
    background: #f1f5f9;
    transform: translateY(-2px);
  }

  .expand-wrapper {
    overflow: hidden;
    transition: max-height 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    max-height: 1500px;
    will-change: max-height;
  }

  .expand-wrapper.collapsed {
    max-height: 380px;
    mask-image: linear-gradient(to bottom, black 60%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 60%, transparent 100%);
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 16px;
  }

  .check-icon-wrapper {
    margin-top: 2px;
    flex-shrink: 0;
  }

  .feature-text {
    font-size: 13px;
    color: #475569;
    font-weight: 500;
    line-height: 1.5;
  }

  .global-see-all-btn {
    margin-top: auto;
    background: none;
    border: none;
    color: #64748b;
    font-weight: 600;
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 24px 0 0 0;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .global-see-all-btn:hover { color: #2380F4; }

  .arrow-icon { transition: transform 0.4s ease; }

  .gst-disclaimer {
    text-align: center;
    color: #94a3b8;
    font-size: 13px;
    margin-top: 60px;
    font-weight: 500;
  }

  @media (max-width: 1024px) {
    .pricing-grid {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin: 0 auto;
    }
  }

  @media (max-width: 768px) {
    .pricing-title {
      font-size: 24px;
      white-space: normal;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/dist/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.js-toggle-all-btn');
    const wrappers = document.querySelectorAll('.js-expand-wrapper');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const isCurrentlyCollapsed = wrappers[0].classList.contains('collapsed');

        wrappers.forEach(w => {
          if (isCurrentlyCollapsed) {
            w.classList.remove('collapsed');
          } else {
            w.classList.add('collapsed');
          }
        });

        buttons.forEach(b => {
          const text = b.querySelector('.btn-text');
          const arrow = b.querySelector('.arrow-icon');
          if (text) text.textContent = isCurrentlyCollapsed ? 'Show less' : 'See all features';
          if (arrow) {
            (arrow as HTMLElement).style.transform = isCurrentlyCollapsed ? 'rotate(180deg)' : 'rotate(0deg)';
          }
        });

        ScrollTrigger.refresh();
      });
    });

    gsap.from('.pricing-header', {
      scrollTrigger: { trigger: '.pricing-premium-section', start: 'top 80%' },
      y: 40, opacity: 0, duration: 1, ease: 'power3.out'
    });

    gsap.from('.pricing-card', {
      scrollTrigger: { trigger: '.pricing-grid', start: 'top 80%' },
      opacity: 0, duration: 0.8, stagger: 0.15, ease: 'power3.out'
    });
  });
</script>
