---
import { Star, CheckCircle2, Quote, MessageSquareQuote } from 'lucide-react';

const testimonials = [
  {
    name: "Vineet B.",
    title: "Exceptional hosting service",
    content: "LiteScaler constantly delivers on their promises of uptime and excellent service. Their team handled everything with ease, and I couldn't be more impressed with the service.",
    rating: 5,
    size: 'tall'
  },
  {
    name: "Jaison J.",
    title: "Outstanding expertise & support",
    content: "I had an outstanding experience with the support team. They not only resolved my issue swiftly but did so with the utmost professionalism and a friendly attitude. Their dedication and expertise truly set them apart. Highly recommended!",
    rating: 5,
    size: 'wide'
  },
  {
    name: "Swagatika S.",
    title: "Serious Speed for Serious Business",
    content: "LiteScaler is a super-fast and reliable host. For anyone who is serious about their online presence, I surely recommend going with them.",
    rating: 5,
    size: 'regular'
  },
  {
    name: "Bhupendra M.",
    title: "Hassle-free Management",
    content: "Excellent security features and a user-friendly control panel make website management a breeze. Reliable technical assistance whenever needed.",
    rating: 5,
    size: 'regular'
  }
];
---

<section class="testimonial-section">
  <div class="background-glow"></div>

  <div class="container">
    <div class="header">
      <div class="badge"><MessageSquareQuote size={14} /> <span>Social Proof</span></div>
      <h2 class="title">Trusted by <span class="gradient-text">Developers</span> Worldwide</h2>
      <p class="subtitle">Join a community of experts who refuse to compromise on speed and security.</p>
    </div>

    <div class="bento-grid">
      {testimonials.map((item) => (
        <div class={`testimonial-card ${item.size}`}>
          <div class="card-inner">
            <div class="quote-watermark"><Quote size={40} /></div>
            
            <div class="user-block">
              <div class="avatar">{item.name.charAt(0)}</div>
              <div class="meta">
                <h4>{item.name}</h4>
                <div class="stars">
                  {[...Array(item.rating)].map(() => (
                    <Star size={12} fill="#6366f1" color="#6366f1" />
                  ))}
                </div>
              </div>
              <div class="verified">
                <CheckCircle2 size={14} />
                <span>Verified</span>
              </div>
            </div>

            <div class="body-block">
              <h5>{item.title}</h5>
              <p>{item.content}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonial-section {
    background-color: transparent;
    padding: 120px 24px;
    position: relative;
    overflow: hidden;
    font-family: 'Inter', system-ui, sans-serif;
  }

  .background-glow {
    position: absolute;
    top: 0; left: 50%;
    transform: translateX(-50%);
    width: 800px; height: 500px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.05) 0%, transparent 70%);
    pointer-events: none;
  }

  .container { max-width: 1200px; margin: 0 auto; position: relative; z-index: 5; }

  /* Header Styles */
  .header { text-align: center; margin-bottom: 80px; }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(99, 102, 241, 0.1);
    color: #6366f1;
    padding: 6px 16px;
    border-radius: 99px;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 20px;
    border: 1px solid rgba(99, 102, 241, 0.2);
  }
  .title { font-size: 52px; font-weight: 800; color: var(--color-text-primary); margin-bottom: 20px; letter-spacing: -2px; }
  .gradient-text { background: var(--text-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .subtitle { color: var(--color-text-secondary); font-size: 18px; max-width: 600px; margin: 0 auto; line-height: 1.6; }

  /* Bento Grid Layout */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: minmax(200px, auto);
    gap: 24px;
  }

  .testimonial-card {
    background: #ffffff;
    backdrop-filter: blur(10px);
    border: 1px solid var(--color-border);
    border-radius: 32px !important;
    padding: 40px;
    position: relative;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-md);
  }

  .testimonial-card:hover {
    transform: scale(1.02) translateY(-5px);
    border-color: var(--color-accent);
    background: var(--color-bg-secondary);
    box-shadow: var(--shadow-lg);
  }

  /* Variant Sizes */
  .tall { grid-row: span 2; }
  .wide { grid-column: span 2; }

  .quote-watermark {
    position: absolute;
    top: 20px;
    right: 30px;
    color: #6366f1;
    opacity: 0.05;
  }

  .user-block {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 30px;
  }

  .avatar {
    width: 48px; height: 48px;
    background: linear-gradient(135deg, #1e293b, #0f172a);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-weight: 700;
  }

  .meta h4 { color: var(--color-text-primary); font-size: 16px; margin: 0 0 4px 0; }
  .stars { display: flex; gap: 2px; }

  .verified {
    margin-left: auto;
    display: flex; align-items: center; gap: 6px;
    color: #34d399; font-size: 11px; font-weight: 700;
    text-transform: uppercase;
    background: rgba(52, 211, 153, 0.05);
    padding: 4px 10px;
    border-radius: 8px;
  }

  .body-block h5 { color: var(--color-text-primary); font-size: 19px; font-weight: 700; margin-bottom: 12px; }
  .body-block p { color: var(--color-text-secondary); font-size: 15px; line-height: 1.7; }

  @media (max-width: 1024px) {
    .bento-grid { grid-template-columns: 1fr 1fr; }
    .wide { grid-column: auto; }
  }

  @media (max-width: 768px) {
    .bento-grid { grid-template-columns: 1fr; }
    .title { font-size: 38px; }
    .tall { grid-row: auto; }
  }
</style>