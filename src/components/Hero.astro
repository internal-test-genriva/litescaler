---
import "../styles/global.css";
import { Search } from 'lucide-react';
---

<section class="hero">
  <video autoplay loop muted playsinline class="hero-video">
    <source src="/hero-bg.mp4" type="video/mp4" />
  </video>
  <div class="hero-overlay"></div>
  <div class="hero-container">
    <div class="hero-content">
      
      <h1 class="hero-title">
        Deploy Faster.<br/>Scale Instantly.
      </h1>
      
      <p class="hero-subtitle">
        Power your growth with industry-leading performance. Scale your business instantly with our enterprise-grade infrastructure designed for modern developers.
      </p>

      <div class="hero-pricing-action">
        <span class="pricing-label">Starting at</span>
        <div class="pricing-display">
          <span class="currency">₹</span>
          <span class="amount">99.00</span>
          <span class="period">/mo</span>
        </div>
      </div>

      <!-- Domain Search -->
      <div class="hero-search" id="domainSearchSection">
        <form class="search-form" id="domainSearchForm" autocomplete="off">
          <div class="hero-search-input-wrapper" id="searchInputWrapper">
            <span class="hero-search-icon" aria-hidden="true">
              <Search size={17} />
            </span>
            <input
              type="text"
              id="heroDomainInput"
              name="domain"
              placeholder="Find your perfect domain (e.g. mysite.com)"
              class="hero-search-input"
              autocomplete="off"
              spellcheck="false"
            />
            <button type="submit" class="hero-search-btn" id="searchBtn">
              <span class="btn-text">Search</span>
              <span class="btn-loading" style="display:none">
                <svg class="spinner" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10" stroke-opacity="0.25"/>
                  <path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"/>
                </svg>
              </span>
            </button>
          </div>
        </form>

        <!-- Results Container -->
        <div class="search-results" id="searchResults" style="display: none;">
          <div class="results-header">
            <span class="results-title">Domain Results</span>
            <button type="button" class="results-close" id="closeResults" aria-label="Close results">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M18 6L6 18M6 6l12 12"/>
              </svg>
            </button>
          </div>
          <div class="results-list" id="resultsList"></div>
          <div class="results-footer">
            <a href="#" class="results-cta" id="continueSearch">Continue searching →</a>
          </div>
        </div>
      </div>

      <!-- Review Badges Row -->
      <div class="reviews-row">

        <!-- Trustpilot Badge -->
        <div class="review-badge" aria-label="Trustpilot rating: 4.9 out of 5, Excellent">
          <div class="rb-logo-row">
            <svg class="tp-star-mark" xmlns="http://www.w3.org/2000/svg" viewBox="20 248 146 148" aria-hidden="true">
              <path fill="#00b67a" d="M164.2 300.7h-54.9l-16.9-52.2-17 52.2-54.9-.1 44.4 32.3-17 52.2 44.4-32.3 44.4 32.3-16.9-52.2z"/>
              <path fill="#005128" d="m123.6 344.7-3.8-11.8-27.4 19.9z"/>
            </svg>
            <span class="rb-wordmark">Trustpilot</span>
          </div>
          <span class="rb-divider" aria-hidden="true"></span>
          <div class="rb-rating-row">
            <div class="rb-stars" aria-label="5 stars">
              <span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" class="tp-star-tile"><rect width="40" height="40" rx="3" fill="#00b67a"/><path fill="#fff" d="M20 28.7 12.1 33l1.5-8.9L7 18l8.9-1.3 4.1-8.2 4.1 8.2L33 18l-6.6 6.1 1.5 8.9z"/></svg></span>
              <span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" class="tp-star-tile"><rect width="40" height="40" rx="3" fill="#00b67a"/><path fill="#fff" d="M20 28.7 12.1 33l1.5-8.9L7 18l8.9-1.3 4.1-8.2 4.1 8.2L33 18l-6.6 6.1 1.5 8.9z"/></svg></span>
              <span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" class="tp-star-tile"><rect width="40" height="40" rx="3" fill="#00b67a"/><path fill="#fff" d="M20 28.7 12.1 33l1.5-8.9L7 18l8.9-1.3 4.1-8.2 4.1 8.2L33 18l-6.6 6.1 1.5 8.9z"/></svg></span>
              <span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" class="tp-star-tile"><rect width="40" height="40" rx="3" fill="#00b67a"/><path fill="#fff" d="M20 28.7 12.1 33l1.5-8.9L7 18l8.9-1.3 4.1-8.2 4.1 8.2L33 18l-6.6 6.1 1.5 8.9z"/></svg></span>
              <span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" class="tp-star-tile"><rect width="40" height="40" rx="3" fill="#00b67a"/><path fill="#fff" d="M20 28.7 12.1 33l1.5-8.9L7 18l8.9-1.3 4.1-8.2 4.1 8.2L33 18l-6.6 6.1 1.5 8.9z"/></svg></span>
            </div>
            <span class="rb-score"><strong>4.9</strong></span>
            <span class="rb-label">Excellent</span>
          </div>
        </div>

        <!-- Separator between badges -->
        <span class="badge-sep" aria-hidden="true"></span>

        <!-- Google Reviews Badge -->
        <div class="review-badge" aria-label="Google rating: 4.8 out of 5">
          <div class="rb-logo-row">
            <svg class="google-g" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57C21.36 18.17 22.56 15.36 22.56 12.25z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            <span class="rb-wordmark">Google</span>
          </div>
          <span class="rb-divider" aria-hidden="true"></span>
          <div class="rb-rating-row">
            <div class="rb-stars" aria-label="4.8 stars">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" class="google-star" aria-hidden="true"><path d="M10 1l2.39 4.84L18 6.72l-4 3.9.94 5.5L10 13.77l-4.94 2.35.94-5.5-4-3.9 5.61-.88z" fill="#FBBC05"/></svg>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" class="google-star" aria-hidden="true"><path d="M10 1l2.39 4.84L18 6.72l-4 3.9.94 5.5L10 13.77l-4.94 2.35.94-5.5-4-3.9 5.61-.88z" fill="#FBBC05"/></svg>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" class="google-star" aria-hidden="true"><path d="M10 1l2.39 4.84L18 6.72l-4 3.9.94 5.5L10 13.77l-4.94 2.35.94-5.5-4-3.9 5.61-.88z" fill="#FBBC05"/></svg>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" class="google-star" aria-hidden="true"><path d="M10 1l2.39 4.84L18 6.72l-4 3.9.94 5.5L10 13.77l-4.94 2.35.94-5.5-4-3.9 5.61-.88z" fill="#FBBC05"/></svg>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" class="google-star" aria-hidden="true"><path d="M10 1l2.39 4.84L18 6.72l-4 3.9.94 5.5L10 13.77l-4.94 2.35.94-5.5-4-3.9 5.61-.88z" fill="#FBBC05"/></svg>
            </div>
            <span class="rb-score"><strong>4.8</strong></span>
            <span class="rb-label">Reviews</span>
          </div>
        </div>

      </div>

    </div>

  </div>

  
</section>

<script>
/**
 * Domain Search Functionality
 * 
 * SECURITY NOTE: This calls WHMCS directly from client-side.
 * For production, configure CORS in WHMCS or use a server-side proxy.
 * 
 * Required WHMCS Configuration:
 * 1. Enable API access in WHMCS Admin
 * 2. Add your domain to allowed CORS origins (if required)
 * 3. Use API credentials with limited permissions
 */

// ===================== CONFIGURATION =====================
// WHMCS URL for cart links - this is needed for the Buy button
const WHMCS_URL = 'https://billing.litescaler.com';

const WHMCS_CONFIG = {
  // url: 'https://billing.litescaler.com', // No longer needed - using server proxy
  // apiIdentifier: 'mIWJ6TjOac1kRXEav9rG3Iksam6pErsy',
  // apiSecret: 'i81VTe5gQZP1r6P7hqBu26RceilQVQUG'
};

// ===================== DOM ELEMENTS =====================
const searchForm = document.getElementById('domainSearchForm');
const searchInput = document.getElementById('heroDomainInput');
const searchBtn = document.getElementById('searchBtn');
const btnText = searchBtn?.querySelector('.btn-text');
const btnLoading = searchBtn?.querySelector('.btn-loading');
const searchResults = document.getElementById('searchResults');
const resultsList = document.getElementById('resultsList');
const closeResults = document.getElementById('closeResults');
const continueSearch = document.getElementById('continueSearch');

// State
let isSearching = false;

// ===================== UTILITIES =====================

function escapeHtml(value) {
  return String(value).replace(/[&<>"']/g, function (ch) {
    switch (ch) {
      case '&': return '&amp;';
      case '<': return '&lt;';
      case '>': return '&gt;';
      case '"': return '&quot;';
      case "'": return '&#39;';
      default: return ch;
    }
  });
}

function formatPrice(price, prefix = '₹', suffix = '') {
  if (price === null || price === 0) return 'TBD';
  const formatted = price.toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  return String(prefix ?? '') + formatted + String(suffix ?? '');
}

function setLoading(loading) {
  if (!searchBtn || !btnText || !btnLoading) return;
  isSearching = loading;
  if (loading) {
    btnText.style.display = 'none';
    btnLoading.style.display = 'inline-flex';
    searchBtn.disabled = true;
  } else {
    btnText.style.display = 'inline';
    btnLoading.style.display = 'none';
    searchBtn.disabled = false;
  }
}

function showError(message) {
  if (!resultsList || !searchResults) return;
  resultsList.innerHTML = '<div class="result-item error">' +
    '<div class="result-icon error">' +
      '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>' +
    '</div>' +
    '<div class="result-info">' +
      '<span class="result-domain error-text">' + escapeHtml(message) + '</span>' +
    '</div>' +
  '</div>';
  searchResults.style.display = 'block';
}

function parseWhmcsResponse(whmcsData, domain) {
  const result = {
    domain: domain,
    available: false,
    premium: false,
    price: null,
    currency: 'INR',
    currencyPrefix: '₹',
    currencySuffix: '',
    renewalPrice: null,
    registrationPeriod: 1,
    error: null
  };

  // WHMCS DomainWhois returns status: "available" | "unavailable" | "error"
  // "error" with empty whois usually means the TLD is supported but domain is available
  const status = typeof whmcsData?.status === 'string' ? whmcsData.status.toLowerCase() : '';
  const whoisText = typeof whmcsData?.whois === 'string' ? whmcsData.whois.toLowerCase() : '';
  const isErrorStatus = status === 'error';
  const hasWhoisData = whoisText.length > 10;

  if (isErrorStatus && !hasWhoisData) {
    // status=error + empty whois = domain is available (TLD supported but no registration)
    result.available = true;
  } else if (status === 'available') {
    result.available = true;
  } else if (status === 'unavailable') {
    result.available = false;
  } else if (hasWhoisData) {
    // Fallback: check whois text for availability indicators
    if (
      whoisText.includes('no match for') ||
      whoisText.includes('not found') ||
      whoisText.includes('no data found') ||
      whoisText.includes('status: free') ||
      whoisText.includes('domain not found')
    ) {
      result.available = true;
    }
  }

  // Pricing comes from our server endpoint (WHMCS GetTLDPricing)
  // Convert USD to INR (approximately 83 INR per USD)
  const USD_TO_INR = 83.0;
  
  if (whmcsData?.currency) {
    if (typeof whmcsData.currency.code === 'string') result.currency = whmcsData.currency.code;
    if (typeof whmcsData.currency.prefix === 'string') result.currencyPrefix = whmcsData.currency.prefix;
    if (typeof whmcsData.currency.suffix === 'string') result.currencySuffix = whmcsData.currency.suffix;
  }

  if (whmcsData?.tldPricing) {
    const register1 = whmcsData.tldPricing.register1;
    const renew1 = whmcsData.tldPricing.renew1;
    // Convert USD to INR for display
    if (typeof register1 === 'number' && Number.isFinite(register1)) {
      result.price = Math.round(register1 * USD_TO_INR);
    }
    if (typeof renew1 === 'number' && Number.isFinite(renew1)) {
      result.renewalPrice = Math.round(renew1 * USD_TO_INR);
    }
  }

  return result;
}

function renderResults(results) {
  if (!resultsList || !searchResults) return;
  
  if (results.length === 0) {
    showError('No domains found. Please try a different search.');
    return;
  }

  const html = results.map(function(result) {
    if (result.error) {
      return '<div class="result-item error">' +
        '<div class="result-icon error">' +
          '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>' +
        '</div>' +
        '<div class="result-info">' +
          '<span class="result-domain error-text">' + escapeHtml(result.error) + '</span>' +
        '</div>' +
      '</div>';
    }

    const isAvailable = result.available;
    const domain = result.domain;
    const price = result.price;
    
    // Extract TLD for badge
    const tldMatch = domain.match(/\.[a-z]{2,}(?:\.[a-z]{2,})?$/i);
    const tld = tldMatch ? tldMatch[0].replace('.', '').toUpperCase() : '';

    let actionHtml;
    if (isAvailable) {
      actionHtml = '<span class="result-price">' + formatPrice(price, result.currencyPrefix, result.currencySuffix) + '<span class="price-period">/yr</span></span>' +
        '<button class="result-btn" data-domain="' + domain + '">Buy Now</button>';
    } else {
      actionHtml = '<span class="result-unavailable">—</span>';
    }

    let iconSvg;
    if (isAvailable) {
      iconSvg = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>';
    } else {
      iconSvg = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6M9 9l6 6"/></svg>';
    }

    let statusHtml = isAvailable ? '' : '<span class="result-status">Already taken</span>';

    return '<div class="result-item ' + (isAvailable ? 'available' : 'unavailable') + '">' +
      '<div class="result-icon ' + (isAvailable ? 'available' : 'unavailable') + '">' + iconSvg + '</div>' +
      '<div class="result-info">' +
        '<div class="result-domain-row"><span class="result-domain">' + escapeHtml(domain) + '</span>' + (tld ? '<span class="result-tld-badge">' + escapeHtml(tld) + '</span>' : '') + '</div>' + statusHtml +
      '</div>' +
      '<div class="result-action">' + actionHtml + '</div>' +
    '</div>';
  }).join('');

  resultsList.innerHTML = html;
  searchResults.style.display = 'block';

  // Add click handlers for Buy buttons
  document.querySelectorAll('.result-btn').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      const domain = e.target.getAttribute('data-domain');
      if (domain) {
        const cartUrl = WHMCS_URL + '/cart.php?a=add&domain=' + encodeURIComponent(domain);
        window.open(cartUrl, '_blank');
      }
    });
  });
}

function hideResults() {
  if (searchResults) {
    searchResults.style.display = 'none';
  }
  if (searchInput) {
    searchInput.value = '';
  }
}

// ===================== MAIN SEARCH HANDLER =====================

async function handleSearch(e) {
  e.preventDefault();
  
  if (isSearching) return;

  const domain = searchInput?.value?.trim().toLowerCase();
  
  if (!domain) {
    showError('Please enter a domain name');
    return;
  }

  if (domain.length < 3) {
    showError('Domain must be at least 3 characters');
    return;
  }

  const cleanDomain = domain
    .replace(/^https?:\/\//, '')
    .replace(/^www\./, '')
    .replace(/[^a-z0-9.-]/g, '');

  if (!cleanDomain || cleanDomain.length < 3) {
    showError('Please enter a valid domain name');
    return;
  }

  setLoading(true);
  hideResults();

  try {
    // Call our server-side proxy instead of WHMCS directly
    const response = await fetch('/api/domain-check', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ domain: cleanDomain })
    });

    if (!response.ok) {
      let payload = null;
      try {
        payload = await response.json();
      } catch {
        // ignore
      }

      const details = payload?.details ? ` — ${payload.details}` : '';
      const body = payload?.body ? ` — ${String(payload.body).slice(0, 240)}` : '';
      showError(`Unable to connect. Please verify WHMCS configuration.${details}${body}`);
      return;
    }

    const whmcsData = await response.json();
    
    const result = parseWhmcsResponse(whmcsData, cleanDomain);
    
    renderResults([result]);

  } catch (error) {
    console.error('Domain search error:', error);
    showError('Unable to connect. Please verify WHMCS configuration.');
  } finally {
    setLoading(false);
  }
}

// ===================== EVENT LISTENERS =====================

if (searchForm) {
  searchForm.addEventListener('submit', handleSearch);
}

if (closeResults) {
  closeResults.addEventListener('click', hideResults);
}

if (continueSearch) {
  continueSearch.addEventListener('click', function(e) {
    e.preventDefault();
    hideResults();
    if (searchInput) searchInput.focus();
  });
}

document.addEventListener('astro:page-load', function() {
  const newSearchForm = document.getElementById('domainSearchForm');
  const newSearchInput = document.getElementById('heroDomainInput');
  const newCloseResults = document.getElementById('closeResults');
  const newContinueSearch = document.getElementById('continueSearch');

  if (newSearchForm) {
    newSearchForm.addEventListener('submit', handleSearch);
  }
  if (newCloseResults) {
    newCloseResults.addEventListener('click', hideResults);
  }
  if (newContinueSearch) {
    newContinueSearch.addEventListener('click', function(e) {
      e.preventDefault();
      hideResults();
      if (newSearchInput) newSearchInput.focus();
    });
  }
});
</script>

<style>
  /* Hero Section */
  .hero {
    position: relative;
    min-height: 115vh;
    background-color: transparent;
    font-family: system-ui, -apple-system, sans-serif;
    color: #f1f5f9;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    overflow: hidden;
    padding: calc(72px + var(--timer-bar-height, 0px) + 18vh) 0 10vh;
  }

  .hero-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    pointer-events: none;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    z-index: 1;
    pointer-events: none;
  }

  /* Background Effects */
  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 2;
    pointer-events: none;
  }

  .grid-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
  }

  /* Container */
  .hero-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 10;
    width: 100%;
  }

  /* Content */
  .hero-content {
    text-align: center;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @keyframes ping {
    75%, 100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  /* Title */
  .hero-title {
    font-size: 48px;
    font-weight: 300;
    color: #ffffff;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 24px;
    margin-top: 0;
    max-width: 900px;
    white-space: wrap;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    margin-left: 0;
    margin-right: 0;
    padding-top: 10px;
    padding-bottom: 10px;
    box-sizing: content-box;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 64px;
    }
  }

  @media (min-width: 1024px) {
    .hero-title {
      font-size: 72px;
    }
  }

  @media (min-width: 1400px) {
    .hero-title {
      font-size: 84px;
    }
  }

  .hero-title-accent {
    color: #34d399;
  }

  .hero-title-gradient {
    background: var(--text-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    white-space: nowrap;
  }

  /* Pricing Action Container */
  .hero-pricing-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 8px 20px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 100px;
    backdrop-filter: blur(10px);
    margin-bottom: 56px;
    position: relative;
