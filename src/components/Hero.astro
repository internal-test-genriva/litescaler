<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Counter animation function
  const startCount = (target: number, duration: number, element: HTMLElement) => {
    let start = 0;
    const increment = (target / (duration / 16)) || 1;
    const timer = setInterval(() => {
      start += increment;
      if (start >= target) {
        element.innerText = target.toString();
        clearInterval(timer);
      } else {
        element.innerText = Math.floor(start).toString();
      }
    }, 16);
  };

  document.addEventListener('DOMContentLoaded', () => {
    // Initial entrance animations removed per request

    // Observation for counts
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const target = entry.target as HTMLElement;
          const countTo = parseInt(target.getAttribute('data-count') || '0');
          if (countTo > 0) {
            startCount(countTo, 2000, target);
            observer.unobserve(target);
          }
        }
      });
    }, { threshold: 0.5 });

    document.querySelectorAll('.count-up').forEach(el => observer.observe(el));
  });
</script>
