---
import { MessageSquare, ShieldCheck, Clock, Check, Terminal, ShieldAlert } from 'lucide-react';
import { Image } from 'astro:assets';
// Ensure the path to your assets folder is correct
import engineerPortrait from '../assets/../assets/image.png';
---

<section class="support-section">
  <div class="container">
    <div class="support-grid">
      
      <div class="image-column">
        <div class="portrait-container">
          <div class="glow-bg"></div>
          
          <div class="grid-backdrop"></div>
          
          <div class="arch-frame"></div>
          
          <Image 
            src={engineerPortrait} 
            alt="Technical Support Engineer" 
            class="support-portrait"
            quality="high"
          />
          
          <div class="floating-badge top-right">
            <Terminal size={16} />
            <span>Root Access Support</span>
          </div>

          <div class="status-card">
            <div class="pulse-icon"></div>
            <span>Engineers Online Now</span>
          </div>
        </div>
      </div>

      <div class="content-column">
        <span class="eyebrow">Reliable Support</span>
        <h2 class="title">Human expertise at your <span class="accent">fingertips</span></h2>
        <p class="description">
          Forget basic troubleshooting. Our Indian-based engineering team provides Tier-3 technical support for complex server environments, ensuring your uptime is never a question.
        </p>

        <div class="support-features">
          <div class="support-item">
            <div class="icon-box"><Clock size={20} /></div>
            <div class="item-text">
              <h4>15-Min Response SLA</h4>
              <p>Guaranteed response times for critical issues, 365 days a year.</p>
            </div>
          </div>

          <div class="support-item">
            <div class="icon-box"><ShieldCheck size={20} /></div>
            <div class="item-text">
              <h4>Zero-Downtime Migration</h4>
              <p>Our experts handle the heavy lifting, moving your data with 0% disruption.</p>
            </div>
          </div>

          <div class="support-item">
            <div class="icon-box"><ShieldAlert size={20} /></div>
            <div class="item-text">
              <h4>Proactive Malware Cleanup</h4>
              <p>We don't just alert you; we actively scan and patch vulnerabilities for you.</p>
            </div>
          </div>
        </div>

        <div class="cta-group">
          <button class="support-cta">
            Chat with an Expert
            <Check size={18} />
          </button>
          <span class="cta-note">Average wait: 42 seconds</span>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .support-section {
    background-color: transparent;
    color: var(--color-text-primary);
    padding: 120px 24px;
    font-family: 'Inter', system-ui, sans-serif;
    overflow: hidden;
  }

  .container { max-width: 1200px; margin: 0 auto; }

  .support-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  /* Enhanced Visual Styles */
  .image-column { position: relative; }
  
  .portrait-container {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: 500px;
  }

  .grid-backdrop {
    position: absolute;
    width: 120%;
    height: 100%;
    background-image: radial-gradient(rgba(35, 128, 244, 0.1) 1px, transparent 1px);
    background-size: 30px 30px;
    mask-image: radial-gradient(circle at center, black, transparent 80%);
    z-index: 0;
  }

  .arch-frame {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 80%;
    background: linear-gradient(180deg, var(--color-bg-secondary) 0%, #ffffff 100%);
    border: 1px solid var(--color-border);
    border-radius: 200px 200px 40px 40px;
    z-index: 1;
  }

  .support-portrait {
    position: relative;
    z-index: 2;
    width: 85%;
    height: auto;
    filter: drop-shadow(0 20px 50px rgba(0,0,0,0.5));
    transition: transform 0.5s ease;
  }

  .portrait-container:hover .support-portrait {
    transform: translateY(-10px);
  }

  .floating-badge {
    position: absolute;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-border);
    padding: 10px 16px;
    border-radius: 16px !important;
    display: flex;
    align-items: center;
    gap: 10px;
    z-index: 3;
    font-size: 13px;
    font-weight: 600;
  }

  .top-right { top: 20%; right: -10%; color: #2380F4; }

  .status-card {
    position: absolute;
    bottom: 40px;
    left: -10%;
    background: #ffffff;
    border: 1px solid var(--color-success);
    padding: 12px 20px;
    border-radius: 32px !important;
    display: flex;
    align-items: center;
    gap: 10px;
    z-index: 4;
  }

  .pulse-icon {
    width: 10px;
    height: 10px;
    background: #34d399;
    border-radius: 50%;
    box-shadow: 0 0 12px #34d399;
  }

  /* Content Styling */
  .title { font-size: 48px; font-weight: 800; line-height: 1.1; margin-bottom: 24px; color: var(--color-text-primary); }
  .accent { color: var(--color-accent); }
  .description { color: var(--color-text-secondary); font-size: 18px; margin-bottom: 40px; line-height: 1.6; }

  .support-features { display: flex; flex-direction: column; gap: 28px; }
  .support-item { display: flex; gap: 20px; }
  
  .icon-box {
    width: 48px; height: 48px;
    background: rgba(35, 128, 244, 0.1);
    color: #2380F4;
    border-radius: 16px !important;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }

  .item-text h4 { font-size: 19px; font-weight: 700; margin-bottom: 4px; color: var(--color-text-primary); }
  .item-text p { color: var(--color-text-secondary); font-size: 15px; }

  .cta-group { margin-top: 50px; display: flex; align-items: center; gap: 20px; }
  .cta-note { font-size: 13px; color: #475569; font-weight: 500; }

  .support-cta {
    background: var(--btn-primary-bg);
    color: #fff;
    padding: 16px 32px;
    border-radius: 14px;
    font-weight: 700;
    border: none;
    cursor: pointer;
    display: flex; align-items: center; gap: 12px;
    transition: all 0.3s ease;
  }

  .support-cta:hover {
    background: #2380F4;
    box-shadow: 0 10px 25px rgba(35, 128, 244, 0.4);
  }

  @media (max-width: 1024px) {
    .support-grid { grid-template-columns: 1fr; gap: 80px; }
    .status-card, .top-right { position: relative; left: 0; right: 0; margin-top: 20px; width: fit-content; }
  }

</style>